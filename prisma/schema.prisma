model CrMatch {
  Id           BigInt    @id @default(autoincrement())
  SeasonId     Int
  Map          String
  StartedAtUtc DateTime  @db.DateTime(6)
  EndedAtUtc   DateTime? @db.DateTime(6)
  TeamAKey     String
  TeamBKey     String
  TeamAName    String    @db.VarChar(256)
  TeamBName    String    @db.VarChar(256)
  TeamSize     Int
  ScoreA       Int
  ScoreB       Int
  Result       String
  EloDeltaA    Int
  EloDeltaB    Int
  /// The website's own id for the match, echoed back by the game server — it is
  /// the argument to `css_cr_go`. Empty for a match started in game with !cr,
  /// which has no website lobby behind it. The column has been on the table
  /// since the plugin started writing it; this model had drifted without it.
  MatchId      String    @default("") @db.VarChar(64)

  @@index([SeasonId])
  @@map("CrMatches")
}

model SharedLoadout {
  ShareKey     String   @id @db.VarChar(16)
  OwnerSteamId BigInt   @db.UnsignedBigInt
  OwnerName    String?
  Name         String
  Data         String   @db.LongText
  Featured     Boolean  @default(false)
  CreatedAt    DateTime @default(now()) @db.DateTime(6)

  @@index([Featured])
  @@map("SharedLoadouts")
}

model WebLiveMatch {
  ServerId     Int      @id
  Data         String   @db.LongText
