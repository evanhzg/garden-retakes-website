generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Season {
  Id           Int       @id @default(autoincrement())
  Name         String
  StartedAtUtc DateTime  @db.DateTime(6)
  EndedAtUtc   DateTime? @db.DateTime(6)
  IsActive     Boolean

  @@map("Seasons")
}

model PlayerProfile {
  SteamId          BigInt   @id
  LastKnownName    String
  FirstSeenAtUtc   DateTime @db.DateTime(6)
  LastSeenAtUtc    DateTime @db.DateTime(6)
  TimeSpentSeconds Int      @default(0)
  accentColor      String?

  @@map("PlayerProfiles")
}

model PlayerSeasonStats {
  Id                   Int       @id @default(autoincrement())
  SeasonId             Int
  SteamId              BigInt
  Elo                  Int
  PeakElo              Int
  RankedRoundsPlayed   Int
  RankedRoundsWon      Int
  UnrankedRoundsPlayed Int
  LastRankedRoundAtUtc DateTime? @db.DateTime(6)
  UpdatedAtUtc         DateTime  @db.DateTime(6)
  IsCalibrating        Boolean   @default(true)

  @@unique([SeasonId, SteamId])
  @@map("PlayerSeasonStats")
}

model PlayerRoundRecord {
  Id                         BigInt   @id @default(autoincrement())
  RoundRecordId              BigInt
  SeasonId                   Int
  Map                        String
  PlayedAtUtc                DateTime @db.DateTime(6)
  IsRanked                   Boolean
  SteamId                    BigInt
  PlayerName                 String
  TeamNum                    Int
  WonRound                   Boolean
  Kills                      Int
  Headshots                  Int
  Assists                    Int
  FlashAssists               Int
  Damage                     Int
  UtilityDamage              Int
  EnemiesFlashed             Int
  EnemyBlindDuration         Float
  Died                       Boolean
  DiedAtSeconds              Float?
  WasTeamKilled              Boolean
  KilledTeammate             Boolean
  DiedEarly                  Boolean
  OpeningKill                Boolean
  OpeningDeath               Boolean
  TradeKills                 Int
  TradedDeath                Boolean
  Kast                       Boolean
  MultiKillCount             Int
  ClutchVersus               Int
  ClutchWon                  Boolean
  BombPlanted                Boolean
  BombDefused                Boolean
  WasAfk                     Boolean
  Rating                     Float
  EloDelta                   Int
  EloAfter                   Int
  /// A team kill after every enemy was dead or the bomb defused — scored the
  /// opposite way to one thrown while the round was live.
  KilledTeammateAfterDecided Boolean  @default(false)
  /// Itemised impact breakdown as JSON: what happened, what it was worth, and
  /// who else was involved. Written by the plugin alongside the rating.
  ImpactBreakdown            String?  @db.Text
  MapPerformancePoints       Float?   @db.Float
  ConsistencyMultiplier      Float?   @db.Float

  @@index([SteamId, PlayedAtUtc])
  @@index([SeasonId, SteamId])
  @@map("PlayerRoundRecords")
}

model RoundRecord {
  Id                   BigInt   @id @default(autoincrement())
  SeasonId             Int
  Map                  String
  PlayedAtUtc          DateTime @db.DateTime(6)
  RoundTypeOrdinal     Int      @default(-1)
  IsRanked             Boolean
  TPlayerCount         Int
  CtPlayerCount        Int
  WinnerTeamNum        Int
  BombSite             String?  @db.VarChar(8)
  BombPlanted          Boolean
  BombDefused          Boolean
  BombExploded         Boolean
  RoundDurationSeconds Float

  @@map("RoundRecords")
}

model GardenSchedulerState {
  Key          String   @id @db.VarChar(64)
  Value        String   @db.VarChar(64)
  UpdatedAtUtc DateTime @db.DateTime(6)

  @@map("GardenSchedulerState")
}

model PlayerConsistency {
  Id                  Int      @id @default(autoincrement())
  SeasonId            Int
  SteamId             BigInt
  LastScoredLocalDate String?  @db.VarChar(10)
  DailyScore          Float
  GlobalScore         Float
  CombinedScore       Float
  Multiplier          Float    @default(1)
  DailyRounds         Int
  GlobalRounds        Int
  LastBonusElo        Int
  UpdatedAtUtc        DateTime @db.DateTime(6)

  @@map("PlayerConsistency")
}

model CrTeamStats {
  Id            Int      @id @default(autoincrement())
  SeasonId      Int
  TeamKey       String
  PlayerNames   String   @db.VarChar(256)
  TeamSize      Int
  Elo           Int
  PeakElo       Int
  MatchesPlayed Int
  MatchesWon    Int
  MatchesDrawn  Int
  RoundsWon     Int
  RoundsLost    Int
  UpdatedAtUtc  DateTime @db.DateTime(6)

  @@unique([SeasonId, TeamKey])
  @@map("CrTeamStats")
}

model WebInventory {
  SteamId   BigInt   @id
  Data      String   @db.LongText
  UpdatedAt DateTime @updatedAt

  @@map("WebInventories")
}

model RetakesLobby {
  Id        String   @id @db.VarChar(64)
  LeaderId  BigInt?
  Mode      String   @default("2v2") @db.VarChar(16)
  CreatedAt DateTime @default(now())

  @@map("RetakesLobbies")
}

model GardenBan {
  SteamId      BigInt    @id
  Name         String
  Reason       String
