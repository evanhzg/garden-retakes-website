}

model PkmnBox {
  Id      String      @id @default(cuid())
  OwnerId BigInt
  Name    String      @default("Box 1")
  Trainer PkmnTrainer @relation(fields: [OwnerId], references: [SteamId], onDelete: Cascade)
  Pokemon PkmnMon[]

  @@index([OwnerId], map: "PkmnBoxes_OwnerId_fkey")
  @@map("PkmnBoxes")
}

model WebGameMatch {
  Id          String   @id @default(uuid())
  GameId      String
  PlayedAtUtc DateTime @default(now()) @db.DateTime(6)
  Players     String   @db.LongText
  WinnerId    BigInt?  @db.UnsignedBigInt
  Scores      String   @db.LongText
  DurationSec Int      @default(0)

  @@index([GameId])
  @@map("WebGameMatches")
}

model WebGameStats {
  SteamId       BigInt   @db.UnsignedBigInt
  GameId        String
  MatchesPlayed Int      @default(0)
  MatchesWon    Int      @default(0)
  TotalScore    Int      @default(0)
  Elo           Int      @default(1000)
  UpdatedAtUtc  DateTime @default(now()) @db.DateTime(6)

  @@id([SteamId, GameId])
  @@map("WebGameStats")
}

model SkinJob {
  id           Int      @id @default(autoincrement())
  workshop_url String   @db.VarChar(2048)
  image_url    String   @db.VarChar(2048)
  status       String   @default("pending") @db.VarChar(50)
  created_at   DateTime @default(now()) @db.DateTime(0)
  updated_at   DateTime @default(now()) @db.DateTime(0)

  @@map("skin_jobs")
}

model FeedClip {
  Id          Int               @id @default(autoincrement())
  SteamId     BigInt            @db.UnsignedBigInt
  Title       String            @db.VarChar(140)
  Description String?           @db.VarChar(500)
  /// "upload" (a file in data/clips) or "youtube" (a video id).
  Kind        String            @db.VarChar(16)
  /// Stored filename for an upload, or the YouTube video id.
  Source      String            @db.VarChar(255)
  /// Poster frame for uploads; YouTube serves its own.
  Thumb       String?           @db.VarChar(255)
  Bytes       Int?
  CreatedAt   DateTime          @default(now()) @db.DateTime(6)
  /// Seconds, when known (the highlight pipeline reports it).
  DurationSec Int?
  /// JSON array of {name,height,url} for R2-hosted clips, newest quality first.
  Variants    String?           @db.Text
  /// Stable id from the highlight pipeline, so a re-publish updates in place.
  ExternalId  String?           @unique @db.VarChar(190)
  /// In-game name from the demo, for players who have no profile on the site.
  /// Shown instead of a bare SteamID64, but never linked.
  PlayerName  String?           @db.VarChar(64)
  /// Hidden from the feed until its owner names it. A clip cut from a /clip
  /// mark arrives with a machine-written title nobody chose, so it waits.
  Unlisted    Boolean           @default(false)
  /// Which play session it came from, for per-session compilations.
  SessionId   String?           @db.VarChar(64)
  /// Comma-separated ids from the fixed tag list in lib/feedShared.
  Tags        String            @default("") @db.VarChar(200)
  Comments    FeedClipComment[]
  Likes       FeedClipLike[]

  @@index([SteamId])
  @@index([CreatedAt])
  @@map("FeedClips")
}

model FeedClipLike {
  ClipId  Int
  SteamId BigInt   @db.UnsignedBigInt
  AtUtc   DateTime @default(now()) @db.DateTime(6)
  Clip    FeedClip @relation(fields: [ClipId], references: [Id], onDelete: Cascade)

  @@id([ClipId, SteamId])
  @@map("FeedClipLikes")
}

model FeedClipComment {
  Id      Int      @id @default(autoincrement())
  ClipId  Int
  SteamId BigInt   @db.UnsignedBigInt
  Body    String   @db.VarChar(500)
  AtUtc   DateTime @default(now()) @db.DateTime(6)
  Clip    FeedClip @relation(fields: [ClipId], references: [Id], onDelete: Cascade)

  @@index([ClipId])
  @@map("FeedClipComments")
}

/// A demo a player uploaded for the highlight pipeline to cut.
///
/// The file itself lives in R2, not here — Vercel caps a request body at
/// 4.5 MB and a demo is 100-300 MB, so the browser PUTs straight to the bucket
/// with a presigned URL. The row tracks what was asked for and how far it got,
/// and the object is deleted once clips exist so demos do not accumulate.
model FeedDemo {
  Id           Int       @id @default(autoincrement())
  SteamId      BigInt    @db.UnsignedBigInt
  FileName     String    @db.VarChar(255)
  /// Object key in the bucket; null once the demo has been wiped.
  ObjectKey    String?   @db.VarChar(320)
  Bytes        BigInt?   @db.UnsignedBigInt
  /// Comma-separated round numbers to cut, or null for every highlight found.
  Rounds       String?   @db.VarChar(120)
  /// Whose plays to cut. Defaults to the uploader.
  FocusSteamId BigInt?   @db.UnsignedBigInt
  /// uploading -> pending -> processing -> done | failed
  Status       String    @default("uploading") @db.VarChar(16)
  Note         String?   @db.VarChar(500)
  ClipCount    Int       @default(0)
  CreatedAt    DateTime  @default(now()) @db.DateTime(6)
  ProcessedAt  DateTime? @db.DateTime(6)
  /// When the pipeline last claimed this demo.
  ///
  /// Only `publish` ever clears `processing`, so a run that crashed, was
  /// interrupted, or hit a machine reboot left the row claimed forever and the
  /// site said "recording in progress" indefinitely. This is what makes a
  /// stalled claim recognisable, so the queue can offer the demo again.
  ProcessingAt DateTime? @db.DateTime(6)

  @@index([SteamId])
  @@index([Status])
  @@map("FeedDemos")
}

/// A saved grenade lineup, shared between the game server and the utility page.
///
/// The plugin writes these when someone records a lineup in practice mode, and
/// the website reads them — the same route the heatmaps already take, rather
/// than shipping JSON files off the game server over FTP.
model GardenNade {
  Id             Int      @id @default(autoincrement())
  Map            String   @db.VarChar(64)
  Name           String   @db.VarChar(120)
  /// Callout the throw is *from*, so several Long lineups stay distinguishable.
  Area           String   @default("") @db.VarChar(64)
  /// smoke | flash | molotov | he | decoy
  Utility        String   @default("smoke") @db.VarChar(16)
  /// default | execute | retake | postplant | trick
  Purpose        String   @default("default") @db.VarChar(16)
  /// T | CT | "" when it works for either side.
  Team           String   @default("") @db.VarChar(2)
  /// standing | jump | step-jump | run | crouch
  ThrowType      String   @default("standing") @db.VarChar(16)
  /// left | right | both — left is a normal throw, right is the short lob.
  ClickType      String   @default("left") @db.VarChar(8)
  /// Where you stand, and where you look.
  StandX         Float
  StandY         Float
  StandZ         Float
  Pitch          Float
  Yaw            Float
  /// Where it lands. Null when the lineup was recorded without one.
  LandX          Float?
  LandY          Float?
  LandZ          Float?
  Notes          String?  @db.VarChar(500)
  /// Filled in later by the clip pipeline.
  ClipUrl        String?  @db.VarChar(500)
  Thumb          String?  @db.VarChar(500)
  /// False when the stand position does not sit on playable geometry — imported
  /// lineups are checked against the radar, recorded ones are true by definition.
  Verified       Boolean  @default(true)
  /// ingame | import
  Source         String   @default("ingame") @db.VarChar(16)
  AddedBySteamId BigInt?  @db.UnsignedBigInt
  CreatedAt      DateTime @default(now()) @db.DateTime(6)
  /// The three stills every lineup site publishes, captured in game by
  /// tools/lineup-capture. Coordinates say where to stand; only a picture says
  /// what to look at, which is the part people actually copy.
  ///
  /// ShotStand — where you stand, wide enough to recognise the spot.
  /// ShotAim   — first person, crosshair on the aim point.
  /// ShotResult— where the grenade ended up.
  ShotStand      String?  @db.VarChar(500)
  ShotAim        String?  @db.VarChar(500)
  ShotResult     String?  @db.VarChar(500)

  @@index([Map])
  @@index([Map, Area])
  @@map("GardenNades")
}

/// A `/clip` mark from the game server, waiting for the pipeline to cut it.
///
/// The server knows *when* something happened but cannot make a video — a demo
/// holds no pictures. So it records the mark, and the local pipeline turns it
/// into a clip later.
model GardenClipRequest {
  Id          Int       @id @default(autoincrement())
  SteamId     BigInt    @db.UnsignedBigInt
  PlayerName  String    @default("") @db.VarChar(64)
  Map         String    @db.VarChar(64)
  /// GOTV demo name without extension, as the server recorded it.
  DemoFile    String    @db.VarChar(160)
  /// One per map load — what groups a night's clips together.
  SessionId   String    @db.VarChar(64)
  /// Server tick when /clip was typed; the clip ends here.
  Tick        Int
  /// How far back from Tick to start.
  DurationSec Int       @default(15)
  /// pending -> processing -> done | failed
  Status      String    @default("pending") @db.VarChar(16)
  Note        String?   @db.VarChar(500)
  /// The published clip, once there is one.
  ClipId      Int?
  CreatedAt   DateTime  @default(now()) @db.DateTime(6)
  ProcessedAt DateTime? @db.DateTime(6)

  @@index([Status])
  @@index([SessionId])
  @@index([SteamId])
  @@map("GardenClipRequests")
}

/// A user's suggestion to fix a lineup's setpos or details.
model GardenCaptureSuggestion {
  Id              Int      @id @default(autoincrement())
  LineupId        Int
  SuggestedSetpos String?  @db.VarChar(500)
  Notes           String?  @db.VarChar(500)
  Status          String   @default("pending") @db.VarChar(16)
  SubmittedBy     BigInt   @db.UnsignedBigInt
  CreatedAt       DateTime @default(now()) @db.DateTime(6)

  @@index([Status])
  @@map("GardenCaptureSuggestions")
}

/// A link on someone's profile, and whether anyone else may see it.
///
/// Steam, Discord and FACEIT are already known from elsewhere — this stores
/// their *visibility* alongside the handles people type in themselves, so one
/// row type covers "show my FACEIT" and "here is my YouTube" rather than the
/// page having two unrelated notions of a connection.
model GardenProfileLink {
  SteamId   BigInt
  /// steam | discord | faceit | x | youtube | instagram
  Provider  String   @db.VarChar(16)
  /// Handle or full URL as typed; empty for providers we already know.
  Handle    String   @default("") @db.VarChar(160)
  /// Off by default: a link nobody chose to publish stays private.
  Public    Boolean  @default(false)
  UpdatedAt DateTime @updatedAt @db.DateTime(6)

  @@id([SteamId, Provider])
  @@map("GardenProfileLinks")
}

/// A medal that can be held. Definitions, not awards.
model GardenMedal {
  Id          Int      @id @default(autoincrement())
  Slug        String   @unique @db.VarChar(48)
  Name        String   @db.VarChar(64)
  Description String   @db.VarChar(240)
  /// Emoji, so a medal needs no asset pipeline to exist.
  Icon        String   @default("?") @db.VarChar(255)
  Colour      String   @default("#e8b53a") @db.VarChar(9)
  /// season (placement) | vote (community) | special (given by hand)
  Kind        String   @default("vote") @db.VarChar(16)
  /// Order in the case, low first.
  Sort        Int      @default(100)
  CreatedAt   DateTime @default(now()) @db.DateTime(6)

  @@map("GardenMedals")
}

/// Somebody holding a medal, for a season.
model GardenPlayerMedal {
  Id        Int      @id @default(autoincrement())
  SteamId   BigInt   @db.UnsignedBigInt
  MedalSlug String   @db.VarChar(48)
  SeasonId  Int
  /// Free text — "1st, 412 votes", "Season 1".
  Note      String?  @db.VarChar(120)
  AwardedAt DateTime @default(now()) @db.DateTime(6)

  @@unique([SteamId, MedalSlug, SeasonId])
  @@index([SteamId])
  @@map("GardenPlayerMedals")
}

/// A community vote. One per season end, open for a fixed window.
model GardenVotePoll {
  Id         Int      @id @default(autoincrement())
  SeasonId   Int
  OpensAt    DateTime @db.DateTime(6)
  ClosesAt   DateTime @db.DateTime(6)
  /// Snapshot of who was eligible when it opened, so the ballot cannot change
  /// under voters if the ladder moves.
  Candidates String   @db.Text
  CreatedAt  DateTime @default(now()) @db.DateTime(6)

  @@index([SeasonId])
  @@map("GardenVotePolls")
}

/// One question on the ballot.
model GardenVoteCategory {
  Id          Int    @id @default(autoincrement())
  PollId      Int
  Slug        String @db.VarChar(48)
  Name        String @db.VarChar(64)
  Description String @db.VarChar(240)
  /// The medal the winner receives.
  MedalSlug   String @db.VarChar(48)
  Sort        Int    @default(100)

  @@unique([PollId, Slug])
  @@map("GardenVoteCategories")
}

/// A ballot line.
///
/// The unique key is what makes "one vote per person per category" true rather
/// than merely intended — the UI could be bypassed, the database cannot.
model GardenVote {
  Id            Int      @id @default(autoincrement())
  CategoryId    Int
  VoterSteamId  BigInt   @db.UnsignedBigInt
  TargetSteamId BigInt   @db.UnsignedBigInt
  CreatedAt     DateTime @default(now()) @db.DateTime(6)
  UpdatedAt     DateTime @updatedAt @db.DateTime(6)

  @@unique([CategoryId, VoterSteamId])
  @@index([CategoryId])
  @@map("GardenVotes")
}

/// A like on a comment.
model FeedClipCommentLike {
  Id        Int      @id @default(autoincrement())
  CommentId Int
  SteamId   BigInt   @db.UnsignedBigInt
  CreatedAt DateTime @default(now()) @db.DateTime(6)

  @@unique([CommentId, SteamId])
  @@index([CommentId])
  @@map("FeedClipCommentLikes")
}

/// A player's standing in competitive retakes.
///
/// Deliberately separate from PlayerSeasonStats. That rating measures the
/// open retakes server, where anyone can join mid-round and the sample is
/// enormous; this one measures 2v2 and 3v3 matches with a veto and a result.
/// Mixing them would let a thousand casual rounds drown out ten matches that
/// were actually played for something.
model GardenCompetitiveRating {
  SteamId        BigInt    @id @db.UnsignedBigInt
  Elo            Int       @default(1000)
  PeakElo        Int       @default(1000)
  /// Placements are the first ten; below that a level is not shown.
  MatchesPlayed  Int       @default(0)
  Wins           Int       @default(0)
  Losses         Int       @default(0)
  Abandons       Int       @default(0)
  LastMatchAtUtc DateTime? @db.DateTime(6)
  UpdatedAt      DateTime  @default(now()) @updatedAt @db.DateTime(6)

  @@map("GardenCompetitiveRatings")
}

model GardenSafeStatus {
  SteamId       BigInt   @id
  Status        String   @db.VarChar(16) // "PROBING", "ACTIVE", "REJECTED", "BANNED", "NONE"
  SafeScore     Float    @default(50.0)
  ToxicityScore Float    @default(50.0)
  TeamplayScore Float    @default(50.0)
  CommScore     Float    @default(50.0)

  @@map("GardenSafeStatuses")
}

model GardenSafeRequest {
  Id            Int      @id @default(autoincrement())
  SteamId       BigInt
  DiscordId     String   @db.VarChar(32)
  Motivation    String   @db.VarChar(1000)
  Gender        String   @db.VarChar(32)
  AgreedToRules Boolean  @default(true)
  Status        String   @default("PENDING") @db.VarChar(16) // "PENDING", "APPROVED", "REJECTED"
  CreatedAt     DateTime @default(now()) @db.DateTime(6)

  @@index([SteamId])
  @@map("GardenSafeRequests")
}

model GardenMatchVote {
  Id            Int      @id @default(autoincrement())
  MatchId       String   @db.VarChar(64)
  VoterSteamId  BigInt
  TargetSteamId BigInt
  Toxicity      Int
  Safeness      Int
  Comm          Int
  Teamplay      Int
  Weight        Float

  @@index([MatchId])
  @@index([TargetSteamId])
  @@map("GardenMatchVotes")
}

model GardenMap {
  Id         Int      @id @default(autoincrement())
  Mode       String   @db.VarChar(32)
  MapName    String   @db.VarChar(64)
  ImageUrl   String?  @db.VarChar(255)
  WorkshopId String?  @db.VarChar(64)
  CreatedAt  DateTime @default(now()) @db.DateTime(6)

  @@index([Mode])
  @@map("GardenMaps")
}

model WebTicket {
  Id           Int      @id @default(autoincrement())
  CreatorId    BigInt   @db.UnsignedBigInt
  AssigneeId   BigInt?  @db.UnsignedBigInt
  Status       String   @default("OPEN") @db.VarChar(16)
  Topic        String   @db.VarChar(128)
  Description  String   @db.Text
  CreatedAtUtc DateTime @default(now()) @db.DateTime(6)
  UpdatedAtUtc DateTime @default(now()) @updatedAt @db.DateTime(6)

  @@index([CreatorId])
  @@index([AssigneeId])
  @@map("WebTickets")
}

model WebReport {
  Id           Int      @id @default(autoincrement())
  ReporterId   BigInt   @db.UnsignedBigInt
  TargetId     BigInt?  @db.UnsignedBigInt
  LobbyId      String?  @db.VarChar(128)
  Reason       String   @db.VarChar(128)
  Details      String   @db.Text
  Status       String   @default("PENDING") @db.VarChar(16)
  CreatedAtUtc DateTime @default(now()) @db.DateTime(6)

  @@index([ReporterId])
  @@index([TargetId])
  @@map("WebReports")
}
