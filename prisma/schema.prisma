  @@map("WebLiveMatches")
}

model GardenHeatmap {
  Id              BigInt   @id @default(autoincrement())
  VictimSteamId   BigInt
  AttackerSteamId BigInt
  MapName         String   @db.VarChar(128)
  VictimX         Float    @db.Float
  VictimY         Float    @db.Float
  VictimZ         Float    @db.Float
  AttackerX       Float    @db.Float
  AttackerY       Float    @db.Float
  AttackerZ       Float    @db.Float
  Weapon          String   @db.VarChar(64)
  IsHeadshot      Boolean
  IsRanked        Boolean
  Site            String?  @db.VarChar(16)
  CreatedAtUtc    DateTime @db.DateTime(6)

  @@index([MapName])
  @@index([VictimSteamId])
  @@index([AttackerSteamId])
  @@map("GardenHeatmaps")
}

model EFMigrationsHistory {
  MigrationId    String @id @db.VarChar(150)
  ProductVersion String @db.VarChar(32)

  @@map("__EFMigrationsHistory")
}

model UserSettings {
  UserId            BigInt @id
  WeaponPreferences String @db.Text

  @@map("UserSettings")
}

/// The half of a competitive retakes loadout the game does not read yet.
///
/// Weapons live in UserSettings above, because the allocator already reads that
/// every buy round and a second copy here would be a settings page that does
/// nothing. Utility preference has no in-game counterpart, so it stays
/// website-owned: your team can read it, the server cannot act on it. Role is
/// the global fallback the plugin reads when a player has no map-specific
/// override in GardenMapRolePreference — see RE5-plugin's SpawnManager.
model GardenRetakeLoadout {
  SteamId        BigInt   @id @db.UnsignedBigInt
  /// One of lib/retakeLoadout ROLES, or "" for none chosen.
  RoleT          String   @default("") @db.VarChar(16)
  RoleCt         String   @default("") @db.VarChar(16)
  IsCaller       Boolean  @default(false)
  /// { pistol: [...], half: [...], full: [...] } — ordered, first choice first.
  UtilityPrefs   String?  @db.Text
  Notes          String?  @db.VarChar(300)
  /// "Buy kevlar" preference for the cheap pistol-round buy (Glock/USP-S),
  /// shown only when that gun is picked — team-only, same as role/notes.
  KevlarPistolT  Boolean  @default(false)
  KevlarPistolCt Boolean  @default(false)
  /// Which bundle is chosen for each side and round type — the loadout picker's
  /// source of truth, and the only field it writes directly:
  /// { "T": { "pistol": "<id>", "half": "<id>", "full": "<id>" }, "CT": {...} }
  ///
  /// Everything below is derived from it on save, and gets its own column so the
  /// game server can read a preference without parsing JSON in SQL. The weapon
  /// half of a bundle is not here at all — it is written through to
  /// UserSettings.WeaponPreferences, which the allocator plugin has always read
  /// and still owns.
  Bundles        String?  @db.Text
  KevlarForceT   Boolean  @default(false)
  KevlarForceCt  Boolean  @default(false)
  KevlarFullT    Boolean  @default(false)
  KevlarFullCt   Boolean  @default(false)
  /// Defuse kit, CT only — there is nothing for a T to defuse.
  KitForceCt     Boolean  @default(false)
  KitFullCt      Boolean  @default(false)
  UpdatedAt      DateTime @default(now()) @updatedAt @db.DateTime(6)

  @@map("GardenRetakeLoadouts")
}

/// Maps a player never wants to be sent to. Up to four of the ten, and it is a
/// preference rather than a veto: the matchmaker pairs two parties only when
/// what both captains allow still leaves enough maps to run a veto on, and
/// widens what counts as enough the longer they have waited.
///
/// Saved per account so it is set once and pre-fills the lobby, where a captain
/// can adjust it for one queue without writing the change back.
model GardenMapPreference {
  SteamId   BigInt   @id @db.UnsignedBigInt
  /// JSON string[] of de_ map names. At most four; longer lists are trimmed on
  /// read, so a row left over from a wider pool cannot quietly empty it.
  Excluded  String   @default("[]") @db.Text
  UpdatedAt DateTime @default(now()) @updatedAt @db.DateTime(6)

  @@map("GardenMapPreferences")
}

/// A role pick that only applies on one map, layered over the global
/// GardenRetakeLoadout.RoleT/RoleCt fallback — e.g. "Anchor" on Mirage
/// specifically means the A-site anchor spot, not the B one. Site only means
/// anything for the roles that hold ground (anchor/rotator); null Site is a
/// map-wide override with no site split. Read by RE5-plugin's SpawnManager to
/// bias (never force) spawn placement in Competitive Retakes matches.
model GardenMapRolePreference {
  SteamId   BigInt   @db.UnsignedBigInt
  /// de_ map name, e.g. "de_mirage".
  Map       String   @db.VarChar(32)
  /// "T" | "CT".
  Side      String   @db.VarChar(2)
  /// One of lib/retakeLoadout ROLES.
  RoleId    String   @db.VarChar(16)
  /// "A" | "B", or null for a map-wide (not site-specific) override.
  Site      String?  @db.VarChar(1)
  UpdatedAt DateTime @default(now()) @updatedAt @db.DateTime(6)

  @@id([SteamId, Map, Side])
  @@map("GardenMapRolePreferences")
}

/// Whether a player has already been walked through the matchmaking
/// tutorial — kept separate from GardenRetakeLoadout so this table's one job
/// stays obvious and a future "replay the tutorial" button has a single flag
/// to flip, not a loadout field to repurpose.
model GardenOnboardingState {
  SteamId                 BigInt  @id @db.UnsignedBigInt
  SeenMatchmakingTutorial Boolean @default(false)
  /// Whether the player has been through the loadout picker. False for
  /// everybody the day this ships, which is the point: the picker is new, the
  /// bundles it writes did not exist before it, and a row saying "already set"
  /// would mean a player never sees the thing that sets them.
  CompletedRetakeSetup    Boolean @default(false)

  @@map("GardenOnboardingStates")
}

