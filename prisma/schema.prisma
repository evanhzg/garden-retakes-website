model FeedClipComment {
  Id      Int      @id @default(autoincrement())
  ClipId  Int
  SteamId BigInt   @db.UnsignedBigInt
  Body    String   @db.VarChar(500)
  AtUtc   DateTime @default(now()) @db.DateTime(6)
  Clip    FeedClip @relation(fields: [ClipId], references: [Id], onDelete: Cascade)

  @@index([ClipId])
  @@map("FeedClipComments")
}

/// A demo a player uploaded for the highlight pipeline to cut.
///
/// The file itself lives in R2, not here — Vercel caps a request body at
/// 4.5 MB and a demo is 100-300 MB, so the browser PUTs straight to the bucket
/// with a presigned URL. The row tracks what was asked for and how far it got,
/// and the object is deleted once clips exist so demos do not accumulate.
model FeedDemo {
  Id           Int       @id @default(autoincrement())
  SteamId      BigInt    @db.UnsignedBigInt
  FileName     String    @db.VarChar(255)
  /// Object key in the bucket; null once the demo has been wiped.
  ObjectKey    String?   @db.VarChar(320)
  Bytes        BigInt?   @db.UnsignedBigInt
  /// Comma-separated round numbers to cut, or null for every highlight found.
  Rounds       String?   @db.VarChar(120)
  /// Whose plays to cut. Defaults to the uploader.
  FocusSteamId BigInt?   @db.UnsignedBigInt
  /// uploading -> pending -> processing -> done | failed
  Status       String    @default("uploading") @db.VarChar(16)
  Note         String?   @db.VarChar(500)
  ClipCount    Int       @default(0)
  CreatedAt    DateTime  @default(now()) @db.DateTime(6)
  ProcessedAt  DateTime? @db.DateTime(6)
  /// When the pipeline last claimed this demo.
  ///
  /// Only `publish` ever clears `processing`, so a run that crashed, was
  /// interrupted, or hit a machine reboot left the row claimed forever and the
  /// site said "recording in progress" indefinitely. This is what makes a
  /// stalled claim recognisable, so the queue can offer the demo again.
  ProcessingAt DateTime? @db.DateTime(6)

  @@index([SteamId])
  @@index([Status])
  @@map("FeedDemos")
}

/// A saved grenade lineup, shared between the game server and the utility page.
///
/// The plugin writes these when someone records a lineup in practice mode, and
/// the website reads them — the same route the heatmaps already take, rather
/// than shipping JSON files off the game server over FTP.
model GardenNade {
  Id        Int     @id @default(autoincrement())
  Map       String  @db.VarChar(64)
  Name      String  @db.VarChar(120)
  /// Callout the throw is *from*, so several Long lineups stay distinguishable.
  Area      String  @default("") @db.VarChar(64)
  /// smoke | flash | molotov | he | decoy
  Utility   String  @default("smoke") @db.VarChar(16)
  /// default | execute | retake | postplant | trick
  Purpose   String  @default("default") @db.VarChar(16)
  /// T | CT | "" when it works for either side.
  Team      String  @default("") @db.VarChar(2)
  /// stand | crouch | walk | jump | w-jump | step-jump | 2step-jump |
  /// run-jump | crouch-jump. Canonical list lives in lib/utilityShared.ts and
  /// is mirrored in the plugin's UtilityModule.ThrowTypes.
  ///
  /// run-jump (an actual run-up from A to B) and w-jump (forward and jump
  /// pressed together, no step taken) are deliberately separate: they are
  /// different throws that land differently, and the old single "run" could
  /// not tell them apart.
  ThrowType String  @default("stand") @db.VarChar(16)
  /// left | right | both — left is a normal throw, right is the short lob.
  ClickType String  @default("left") @db.VarChar(8)
  /// Where you stand, and where you look.
  StandX    Float
  StandY    Float
  StandZ    Float
  Pitch     Float
  Yaw       Float
  /// Where it lands. Null when the lineup was recorded without one.
  LandX     Float?
  LandY     Float?
  LandZ     Float?
  Notes     String? @db.VarChar(500)
  /// Filled in later by the clip pipeline.
  ClipUrl   String? @db.VarChar(500)
  Thumb     String? @db.VarChar(500)
  /// False when the stand position does not sit on playable geometry — imported
  /// lineups are checked against the radar, recorded ones are true by definition.
  Verified  Boolean @default(true)
  /// ingame | import
  ///
  /// Kept for the rows that predate SourceKind. New writers set both; anything
  /// reading provenance should read SourceKind, which is the one with values
  /// the page actually distinguishes.
  Source    String  @default("ingame") @db.VarChar(16)

  /// ingame | demo | community | import — where this lineup came from.
  ///
  /// Source existed and nothing in the UI ever read it, so the page
  /// distinguished Verified instead and the two were correlated only by the
  /// importer's convention. This is the one the Resources tab filters on.
  SourceKind String @default("ingame") @db.VarChar(16)

  /// Human-readable credit, e.g. "NAVI vs G2, IEM Katowice 2026".
  SourceLabel String? @db.VarChar(200)

  /// Where it came from, when there is somewhere to point at.
  SourceUrl String? @db.VarChar(500)

  /// How many times a mined lineup was seen across the demos it came from.
  ///
  /// The ordering that makes a mined set useful: eleven sightings is a lineup
  /// the pros rely on, one is somebody improvising. Null on anything not mined.
  Popularity     Int?
  AddedBySteamId BigInt?  @db.UnsignedBigInt
  CreatedAt      DateTime @default(now()) @db.DateTime(6)
  /// The three stills every lineup site publishes, captured in game by
  /// tools/lineup-capture. Coordinates say where to stand; only a picture says
  /// what to look at, which is the part people actually copy.
  ///
  /// ShotStand — where you stand, wide enough to recognise the spot.
  /// ShotAim   — first person, crosshair on the aim point.
  /// ShotResult— where the grenade ended up.
  ShotStand      String?  @db.VarChar(500)
  ShotAim        String?  @db.VarChar(500)
  ShotResult     String?  @db.VarChar(500)

  /// Set on rows whose throw type was guessed by the taxonomy migration rather
  /// than recorded. Surfaces in the Maker tab so a guess can be confirmed or
  /// corrected instead of quietly standing as fact.
  NeedsReview Boolean @default(false)
  /// Waiting for the three stills. Drives the capture queue — screenshots need
  /// a rendering client (see tools/lineup-capture), so this is a queue rather
  /// than something the server can satisfy itself.
  NeedsShots  Boolean @default(true)
  /// Whether the stand position came from an explicit !lineup mark rather than
  /// the last-grounded fallback. A run-up lineup recorded without a mark is
  /// still usable but less exact, and the tab should say which it is.
  MarkedStand Boolean @default(false)

  /// The arc the grenade actually flew: [[x,y,z,t],…], decimated server-side.
  ///
  /// Recorded during capture, because it is the one preview a dedicated server
  /// can produce — screenshots need a rendering client, and the shape of a
  /// throw is the thing a still can never show and people watch nade videos
  /// for. Null on anything captured before this existed, or imported.
  Path String? @db.Text

  @@index([Map])
  @@index([Map, Area])
  @@index([NeedsShots])
  @@map("GardenNades")
}

/// The lineup currently being captured, one row per admin.
///
/// Keyed by SteamId rather than autoincrement on purpose: throwing again
/// replaces the pending capture instead of stacking a second one, which is
/// exactly the "re-throw overwrites until you Validate" behaviour. Validating
/// promotes it into GardenNades and deletes the row.
model GardenNadeDraft {
  SteamId     BigInt   @id @db.UnsignedBigInt
  Map         String   @db.VarChar(64)
  Utility     String   @default("smoke") @db.VarChar(16)
  Team        String   @default("") @db.VarChar(2)
  ThrowType   String   @default("stand") @db.VarChar(16)
  ClickType   String   @default("left") @db.VarChar(8)
  StandX      Float
  StandY      Float
  StandZ      Float
  Pitch       Float
  Yaw         Float
  LandX       Float?
  LandY       Float?
  LandZ       Float?
  /// True when !lineup mark set the stand point; false when it fell back to
  /// the last grounded position before the jump.
  MarkedStand Boolean  @default(false)
  /// Filled in a couple of seconds after the rest of the row: the draft is
  /// written when the grenade leaves the hand, the arc when it stops flying.
  Path        String?  @db.Text
  CapturedAt  DateTime @default(now()) @db.DateTime(6)

  @@map("GardenNadeDrafts")
}

/// A `/clip` mark from the game server, waiting for the pipeline to cut it.
///
/// The server knows *when* something happened but cannot make a video — a demo
/// holds no pictures. So it records the mark, and the local pipeline turns it
/// into a clip later.
model GardenClipRequest {
  Id          Int       @id @default(autoincrement())
  SteamId     BigInt    @db.UnsignedBigInt
  PlayerName  String    @default("") @db.VarChar(64)
  Map         String    @db.VarChar(64)
  /// GOTV demo name without extension, as the server recorded it.
  DemoFile    String    @db.VarChar(160)
  /// One per map load — what groups a night's clips together.
  SessionId   String    @db.VarChar(64)
  /// Server tick when /clip was typed; the clip ends here.
  Tick        Int
  /// The round being played when /clip was typed, one-based.
  ///
  /// Stamped by the plugin, which knows it at that moment; reconstructing it
  /// from Tick afterwards needs the round boundaries out of the demo. Null on
  /// every row written before this column existed — zero would be a claim.
  Round       Int?
  /// How far back from Tick to start.
  DurationSec Int       @default(15)
  /// pending -> processing -> done | failed
  Status      String    @default("pending") @db.VarChar(16)
  Note        String?   @db.VarChar(500)
  /// The published clip, once there is one.
  ClipId      Int?
  CreatedAt   DateTime  @default(now()) @db.DateTime(6)
  ProcessedAt DateTime? @db.DateTime(6)

  @@index([Status])
  @@index([SessionId])
  @@index([SteamId])
  @@map("GardenClipRequests")
}

/// A user's suggestion to fix a lineup's setpos or details.
model GardenCaptureSuggestion {
  Id              Int      @id @default(autoincrement())
  LineupId        Int
  SuggestedSetpos String?  @db.VarChar(500)
  Notes           String?  @db.VarChar(500)
  Status          String   @default("pending") @db.VarChar(16)
  SubmittedBy     BigInt   @db.UnsignedBigInt
  CreatedAt       DateTime @default(now()) @db.DateTime(6)

  @@index([Status])
  @@map("GardenCaptureSuggestions")
}

/// A link on someone's profile, and whether anyone else may see it.
///
/// Steam, Discord and FACEIT are already known from elsewhere — this stores
/// their *visibility* alongside the handles people type in themselves, so one
/// row type covers "show my FACEIT" and "here is my YouTube" rather than the
/// page having two unrelated notions of a connection.
model GardenProfileLink {
  SteamId   BigInt
  /// steam | discord | faceit | x | youtube | instagram
  Provider  String   @db.VarChar(16)
  /// Handle or full URL as typed; empty for providers we already know.
  Handle    String   @default("") @db.VarChar(160)
  /// Off by default: a link nobody chose to publish stays private.
  Public    Boolean  @default(false)
  UpdatedAt DateTime @updatedAt @db.DateTime(6)

  @@id([SteamId, Provider])
  @@map("GardenProfileLinks")
}

/// A medal that can be held. Definitions, not awards.
model GardenMedal {
  Id          Int      @id @default(autoincrement())
  Slug        String   @unique @db.VarChar(48)
  Name        String   @db.VarChar(64)
  Description String   @db.VarChar(240)
  /// Emoji, so a medal needs no asset pipeline to exist.
  Icon        String   @default("?") @db.VarChar(255)
  Colour      String   @default("#e8b53a") @db.VarChar(9)
  /// season (placement) | vote (community) | special (given by hand)
  Kind        String   @default("vote") @db.VarChar(16)
  /// Order in the case, low first.
  Sort        Int      @default(100)
  CreatedAt   DateTime @default(now()) @db.DateTime(6)

  @@map("GardenMedals")
}

/// Somebody holding a medal, for a season.
model GardenPlayerMedal {
  Id        Int      @id @default(autoincrement())
  SteamId   BigInt   @db.UnsignedBigInt
  MedalSlug String   @db.VarChar(48)
  SeasonId  Int
  /// Free text — "1st, 412 votes", "Season 1".
  Note      String?  @db.VarChar(120)
  AwardedAt DateTime @default(now()) @db.DateTime(6)

  @@unique([SteamId, MedalSlug, SeasonId])
  @@index([SteamId])
  @@map("GardenPlayerMedals")
}

/// A community vote. One per season end, open for a fixed window.
model GardenVotePoll {
  Id         Int      @id @default(autoincrement())
  SeasonId   Int
  OpensAt    DateTime @db.DateTime(6)
  ClosesAt   DateTime @db.DateTime(6)
  /// Snapshot of who was eligible when it opened, so the ballot cannot change
  /// under voters if the ladder moves.
  Candidates String   @db.Text
  CreatedAt  DateTime @default(now()) @db.DateTime(6)

  @@index([SeasonId])
  @@map("GardenVotePolls")
}

/// One question on the ballot.
model GardenVoteCategory {
  Id          Int    @id @default(autoincrement())
  PollId      Int
  Slug        String @db.VarChar(48)
  Name        String @db.VarChar(64)
  Description String @db.VarChar(240)
  /// The medal the winner receives.
  MedalSlug   String @db.VarChar(48)
  Sort        Int    @default(100)

  @@unique([PollId, Slug])
  @@map("GardenVoteCategories")
}

/// A ballot line.
///
/// The unique key is what makes "one vote per person per category" true rather
/// than merely intended — the UI could be bypassed, the database cannot.
model GardenVote {
  Id            Int      @id @default(autoincrement())
  CategoryId    Int
  VoterSteamId  BigInt   @db.UnsignedBigInt
  TargetSteamId BigInt   @db.UnsignedBigInt
  CreatedAt     DateTime @default(now()) @db.DateTime(6)
  UpdatedAt     DateTime @updatedAt @db.DateTime(6)

  @@unique([CategoryId, VoterSteamId])
  @@index([CategoryId])
  @@map("GardenVotes")
}

/// A like on a comment.
model FeedClipCommentLike {
  Id        Int      @id @default(autoincrement())
  CommentId Int
  SteamId   BigInt   @db.UnsignedBigInt
  CreatedAt DateTime @default(now()) @db.DateTime(6)

  @@unique([CommentId, SteamId])
  @@index([CommentId])
  @@map("FeedClipCommentLikes")
}

/// A player's standing in competitive retakes.
///
/// Deliberately separate from PlayerSeasonStats. That rating measures the
/// open retakes server, where anyone can join mid-round and the sample is
/// enormous; this one measures 2v2 and 3v3 matches with a veto and a result.
/// Mixing them would let a thousand casual rounds drown out ten matches that
/// were actually played for something.
model GardenCompetitiveRating {
  SteamId        BigInt    @id @db.UnsignedBigInt
  Elo            Int       @default(1000)
  PeakElo        Int       @default(1000)
  /// Placements are the first ten; below that a level is not shown.
  MatchesPlayed  Int       @default(0)
  Wins           Int       @default(0)
  Losses         Int       @default(0)
  Abandons       Int       @default(0)
  LastMatchAtUtc DateTime? @db.DateTime(6)
  UpdatedAt      DateTime  @default(now()) @updatedAt @db.DateTime(6)

  @@map("GardenCompetitiveRatings")
}

model GardenSafeStatus {
  SteamId       BigInt @id
  Status        String @db.VarChar(16) // "PROBING", "ACTIVE", "REJECTED", "BANNED", "NONE"
  SafeScore     Float  @default(50.0)
  ToxicityScore Float  @default(50.0)
  TeamplayScore Float  @default(50.0)
  CommScore     Float  @default(50.0)

  @@map("GardenSafeStatuses")
}

model GardenSafeRequest {
  Id            Int      @id @default(autoincrement())
  SteamId       BigInt
  DiscordId     String   @db.VarChar(32)
  Motivation    String   @db.VarChar(1000)
  Gender        String   @db.VarChar(32)
  AgreedToRules Boolean  @default(true)
  Status        String   @default("PENDING") @db.VarChar(16) // "PENDING", "APPROVED", "REJECTED"
  CreatedAt     DateTime @default(now()) @db.DateTime(6)

  @@index([SteamId])
  @@map("GardenSafeRequests")
}

model GardenMatchVote {
  Id            Int    @id @default(autoincrement())
  MatchId       String @db.VarChar(64)
  VoterSteamId  BigInt
  TargetSteamId BigInt
  Toxicity      Int
  Safeness      Int
  Comm          Int
  Teamplay      Int
  Weight        Float

  @@index([MatchId])
  @@index([TargetSteamId])
  @@map("GardenMatchVotes")
}

model GardenMap {
  Id              Int      @id @default(autoincrement())
  Mode            String   @db.VarChar(32)
  MapName         String   @db.VarChar(64)
  ImageUrl        String?  @db.VarChar(255)
  WorkshopId      String?  @db.VarChar(64)
  /// What a person should see, when it differs from the file name — "Dust II"
  /// rather than "de_dust2". Null falls back to the file name.
  DisplayName     String?  @db.VarChar(64)
  /// Whether a tournament may use this map. Off by default, so adding a map to
  /// the ladder's cycle does not silently make it vetoable in a bracket.
  TournamentReady Boolean  @default(false)
  CreatedAt       DateTime @default(now()) @db.DateTime(6)

  @@index([Mode])
  @@map("GardenMaps")
}

model WebTicket {
  Id           Int      @id @default(autoincrement())
  CreatorId    BigInt   @db.UnsignedBigInt
  AssigneeId   BigInt?  @db.UnsignedBigInt
  Status       String   @default("OPEN") @db.VarChar(16)
  Topic        String   @db.VarChar(128)
  Description  String   @db.Text
  CreatedAtUtc DateTime @default(now()) @db.DateTime(6)
  UpdatedAtUtc DateTime @default(now()) @updatedAt @db.DateTime(6)

  @@index([CreatorId])
  @@index([AssigneeId])
  @@map("WebTickets")
}

model WebReport {
  Id           Int      @id @default(autoincrement())
  ReporterId   BigInt   @db.UnsignedBigInt
  TargetId     BigInt?  @db.UnsignedBigInt
  LobbyId      String?  @db.VarChar(128)
  Reason       String   @db.VarChar(128)
  Details      String   @db.Text
  Status       String   @default("PENDING") @db.VarChar(16)
  CreatedAtUtc DateTime @default(now()) @db.DateTime(6)

  @@index([ReporterId])
  @@index([TargetId])
  @@map("WebReports")
}

// ---------------------------------------------------------------- Game Maker
//
// One authoring model behind four game modes. Duels arenas, Retakes site
// setups, Executes strats and Fast Strat plays were four separate per-map JSON
// files on the game server, each editable only through its own in-game admin
// command and invisible to the website. They are all, structurally, the same
// thing: a named group of positioned spawns, sometimes with utility attached.
//
// The database is the source of truth; the plugin reads it on map load and
// writes a JSON snapshot beside its old files so a DB outage degrades to
// "last known good" rather than "no spawns at all". Follows the GardenNade
// precedent — plugin-authored coordinates living in the shared MySQL so the
// website can render and edit them.

/// A named group of spawns: a Duels arena, a Retakes site setup, an Executes
/// strat, or a Fast Strat play. What varies between modes is which of the
/// optional columns carry meaning, not the shape.
model GmSet {
  Id   Int    @id @default(autoincrement())
  /// "duels" | "retakes" | "executes" | "faststrat"
  Mode String @db.VarChar(16)
  /// de_ map name, or a workshop map's resolved name.
  Map  String @db.VarChar(64)
  Name String @db.VarChar(64)

  /// "A" | "B" — required by Retakes/Executes, deliberately null for Fast
  /// Strat, where the two sides' picks need not concern the same site.
  Site String? @db.VarChar(1)

  /// Fast Strat only: "early" | "mid" | "end" — which part of the round this
  /// play is for, with the timer that phase runs on.
  Phase        String? @db.VarChar(8)
  PhaseSeconds Int?

  /// JSON string arrays. Roles this set concerns (Retakes: sniper/anchor/…)
  /// and which round types it applies to (pistol/half/full).
  Roles      String? @db.Text
  RoundTypes String? @db.Text

  /// Fast Strat draws its votable pool from these; Executes ignores it.
  Votable Boolean @default(false)
  /// 0 = never picked at random.
  Weight  Int     @default(1)
  /// Toggled from the website; the plugin skips inactive sets entirely.
  Active  Boolean @default(true)

  AddedBy   BigInt?  @db.UnsignedBigInt
  CreatedAt DateTime @default(now()) @db.DateTime(6)
  UpdatedAt DateTime @default(now()) @updatedAt @db.DateTime(6)

  Spawns    GmSpawn[]
  Utilities GmUtility[]

  @@unique([Mode, Map, Name])
  @@index([Mode, Map, Active])
  @@map("GmSets")
}

/// One positioned spawn inside a set. `Type` is mode-specific and free-form on
/// purpose — Duels wants "ak_only"/"close"/"long"/"awp_only", Retakes wants a
/// role id — and pinning it to an enum here would mean a migration every time a
/// mode grows a category.
model GmSpawn {
  Id    Int    @id @default(autoincrement())
  SetId Int
  /// "T" | "CT".
  Side  String @db.VarChar(2)
  Type  String @default("") @db.VarChar(32)
  /// Free label, e.g. "A Site", "Long doors".
  Label String @default("") @db.VarChar(48)

  X     Float
  Y     Float
  Z     Float
  Pitch Float @default(0)
  Yaw   Float @default(0)

  /// Duels pairs a T spawn against a CT spawn; same Pairing groups them.
  Pairing  Int?
  /// T-side Retakes spawn that may plant.
  CanPlant Boolean @default(false)
  Active   Boolean @default(true)

  Set GmSet @relation(fields: [SetId], references: [Id], onDelete: Cascade)

  @@index([SetId, Side])
  @@map("GmSpawns")
}

/// Utility belonging to a set.
///
/// Delivery is the real split between Executes and Fast Strat: an Execute
/// throws its nades from a recorded lineup at round start, while a Fast Strat
/// play starts with the smoke already sitting on the ground — the round opens
/// mid-execute rather than watching one happen.
model GmUtility {
  Id       Int    @id @default(autoincrement())
  SetId    Int
  /// "smoke" | "flash" | "he" | "molotov"
  Type     String @db.VarChar(8)
  /// "T" | "CT" — which side's lineup this was.
  Team     String @db.VarChar(2)
  /// "thrown" (fly the recorded lineup) | "grounded" (already deployed).
  Delivery String @default("thrown") @db.VarChar(8)

  X Float
  Y Float
  Z Float

  /// Only meaningful when Delivery is "thrown".
  VelX Float @default(0)
  VelY Float @default(0)
  VelZ Float @default(0)

  DelaySeconds Float   @default(0)
  Active       Boolean @default(true)

  Set GmSet @relation(fields: [SetId], references: [Id], onDelete: Cascade)

  @@index([SetId])
  @@map("GmUtilities")
}

/// Mode Maker: a pitch for an entirely new game mode. Config and the node
/// graph are JSON blobs rather than columns — the whole point of the tab is
/// that the shape of an idea is not known in advance, and a schema that
/// constrained it would defeat it.
model GmModeProposal {
  Id      Int    @id @default(autoincrement())
  Slug    String @unique @db.VarChar(64)
  Title   String @db.VarChar(96)
  Summary String @default("") @db.VarChar(500)
  /// "draft" | "review" | "accepted" | "shelved"
  Status  String @default("draft") @db.VarChar(16)

  /// Free-form settings the proposal wants (round length, team sizes, …).
  Config String? @db.LongText
  /// { nodes: [...], edges: [...] } for the canvas.
  Graph  String? @db.LongText

  AuthorSteamId BigInt?  @db.UnsignedBigInt
  CreatedAt     DateTime @default(now()) @db.DateTime(6)
  UpdatedAt     DateTime @default(now()) @updatedAt @db.DateTime(6)

  @@index([Status])
  @@map("GmModeProposals")
}

/// One StatTrak counter: a player's kills with one item, in one season.
///
/// Season-scoped on purpose. A counter that never resets is one nobody can
/// catch up with, and it makes a knife carried since season 1 incomparable to
/// anything a new player owns. The row is created by the first kill of the
/// season with that item, so an item that crosses a season boundary starts
/// again without anything having to run a reset.
model GardenStatTrakCount {
  Id       BigInt @id @default(autoincrement())
  SeasonId Int
  SteamId  BigInt @db.UnsignedBigInt
  /// The plugin-facing item id — `InventoryStore.items[].uid`, which is what
  /// the increment POST sends back as `targetUid`. Not the cs2-lib item id.
  Uid      Int
  Kills    Int    @default(0)

  UpdatedAt DateTime @default(now()) @updatedAt @db.DateTime(6)

  @@unique([SeasonId, SteamId, Uid])
  @@index([SeasonId, SteamId])
  @@map("GardenStatTrakCounts")
}

/// A tournament spawn: what a position is, as opposed to where it is.
///
/// The Maker tool has two halves. The website owns the name, the role and which
/// site and side a spawn serves; the plugin owns the coordinates, because those
/// are decided by standing in them. Positions arrive from the plugin as they are
/// placed — see app/api/tournament/maker/variants.
///
/// This is not what the game reads. The plugin's own tournament_spawns/<map>.json
/// stays the file a round is placed from; this is the record of what was authored
/// and the thing GENERATE writes that file from.
model TournamentSpawn {
  Id           Int      @id @default(autoincrement())
  Map          String   @db.VarChar(64)
  Name         String   @db.VarChar(64)
  RoleId       String   @db.VarChar(24)
  /// 0 = A, 1 = B, matching the plugin's Bombsite enum.
  Bombsite     Int      @db.TinyInt
  /// 2 = T, 3 = CT, matching CS2's own team numbers.
  Team         Int      @db.TinyInt
  CanBePlanter Boolean  @default(false)
  Sort         Int      @default(100)
  CreatedBy    BigInt?  @db.UnsignedBigInt
  CreatedAt    DateTime @default(now()) @db.DateTime(6)
  UpdatedAt    DateTime @default(now()) @updatedAt @db.DateTime(6)

  Variants TournamentSpawnVariant[]

  /// (place, role) is the identity, not place alone.
  ///
  /// "Short" is a PLACE and a role is a JOB, and a site is authored by putting
  /// several jobs in one place — a front-runner holding Short, a backup behind
  /// them, a roamer cutting through. Without RoleId in the key the second one
  /// silently overwrote the first: same row, new role, and the earlier role's
  /// variants inherited by whoever was saved last.
  @@unique([Map, Bombsite, Team, Name, RoleId], map: "UX_TournamentSpawns")
  @@index([Map])
  @@map("TournamentSpawns")
}

/// One way to stand in a position. Several variants of one spawn are what stop
/// two players who chose the same place ending up inside each other.
model TournamentSpawnVariant {
  Id        Int      @id @default(autoincrement())
  SpawnId   Int
  X         Float
  Y         Float
  Z         Float
  Yaw       Float    @default(0)
  /// Stored rather than derived on read: an admin pastes these into a console to
  /// stand where the variant is, and a rounding difference between the page and
  /// the game is the kind of discrepancy nobody thinks to question.
  SetPos    String   @db.VarChar(96)
  ViewPos   String   @db.VarChar(96)
  CreatedAt DateTime @default(now()) @db.DateTime(6)

  Spawn TournamentSpawn @relation(fields: [SpawnId], references: [Id], onDelete: Cascade)

  @@index([SpawnId])
  @@map("TournamentSpawnVariants")
}

/// Which server somebody is authoring on, so the page knows where to send
/// SELECT IN-GAME and GENERATE.
model TournamentMakerSession {
  Id        Int       @id @default(autoincrement())
  ServerId  Int       @default(1)
  SpawnId   Int
  SteamId   BigInt    @db.UnsignedBigInt
  Map       String    @db.VarChar(64)
  StartedAt DateTime  @default(now()) @db.DateTime(6)
  EndedAt   DateTime? @db.DateTime(6)

  @@index([ServerId, EndedAt])
  @@map("TournamentMakerSessions")
}

/// A tournament. Stages hold the format; this holds the identity.
model Tournament {
  Id           Int       @id @default(autoincrement())
  Slug         String    @unique(map: "UX_Tournaments_Slug") @db.VarChar(64)
  Name         String    @db.VarChar(128)
  Description  String?   @db.Text
  /// draft | registration | live | finished | cancelled
  State        String    @default("draft") @db.VarChar(16)
  TeamSize     Int       @default(3) @db.TinyInt
  MaxTeams     Int       @default(16)
  OwnerSteamId BigInt?   @db.UnsignedBigInt
  StartsAt     DateTime? @db.DateTime(6)
  Config       String?   @db.Text
  CreatedAt    DateTime  @default(now()) @db.DateTime(6)
  UpdatedAt    DateTime  @default(now()) @updatedAt @db.DateTime(6)

  /// public | invite. Gates who may CREATE A TEAM, not who may watch — an
  /// invite-only tournament's bracket is still readable by anyone.
  Visibility  String  @default("public") @db.VarChar(16)
  /// The token in the invite link. Null until invite-only is turned on.
  InviteToken String? @db.VarChar(32)

  /// single | double | group | swiss, and the series length. Editable until the
  /// start button is pressed, which is why they live here and not only on a
  /// stage: stages do not exist until the bracket is generated.
  Format      String @default("single") @db.VarChar(16)
  /// random | faceit | manual — how seeds are decided at generation.
  Seeding     String @default("random") @db.VarChar(16)
  BestOf      Int    @default(1) @db.TinyInt
  FinalBestOf Int?   @db.TinyInt

  /// Whether anyone but an organizer can see it. A tournament is built in
  /// private and published deliberately. Distinct from State: a published
  /// tournament can still be in registration.
  Published Boolean   @default(false)
  /// When start was actually pressed. StartsAt is the plan; this is the fact,
  /// and it is what makes "editable until it starts" answerable.
  StartedAt DateTime? @db.DateTime(6)

  RulesText    String? @db.Text
  PrizeText    String? @db.Text
  SponsorsText String? @db.Text

  DiscordUrl     String? @db.VarChar(255)
  TeamSpeakUrl   String? @db.VarChar(255)
  /// Comma-separated channel names — a handful of strings edited as one field
  /// and never queried across, so a table would be ceremony.
  TwitchChannels String? @db.VarChar(500)

  Stages     TournamentStage[]
  Teams      TournamentTeam[]
  Matches    TournamentMatch[]
  Maps       TournamentMap[]
  Spectators TournamentSpectator[]
  Organizers TournamentOrganizer[]

  @@map("Tournaments")
}

/// May create tournaments. Deliberately not a fourth GardenAdmins level — that
/// column is a ladder used for immunity, and an organizer is a different job
/// rather than a rung on it. See lib/tournamentRoles.ts.
model GardenOrganizer {
  SteamId        BigInt   @id @db.UnsignedBigInt
  Name           String?  @db.VarChar(64)
  AddedBySteamId BigInt?  @db.UnsignedBigInt
  AddedAt        DateTime @default(now()) @db.DateTime(6)

  @@map("GardenOrganizers")
}

/// Who may manage one tournament. Several per event, which is why it is a table
/// and not a column on Tournaments.
model TournamentOrganizer {
  Id           Int      @id @default(autoincrement())
  TournamentId Int
  SteamId      BigInt   @db.UnsignedBigInt
  Name         String?  @db.VarChar(64)
  /// The one who created it. The last organizer cannot be removed.
  IsCreator    Boolean  @default(false)
  AddedAt      DateTime @default(now()) @db.DateTime(6)

  Tournament Tournament @relation(fields: [TournamentId], references: [Id], onDelete: Cascade)

  @@unique([TournamentId, SteamId], map: "UX_TournamentOrganizers")
  @@index([SteamId])
  @@map("TournamentOrganizers")
}

/// One phase of a tournament. The difference between a swiss and a group phase
/// is settings rather than structure, so the rules live in Config rather than in
/// columns that would be null for every other kind.
model TournamentStage {
  Id           Int     @id @default(autoincrement())
  TournamentId Int
  Name         String  @db.VarChar(64)
  /// group | swiss | single | double
  Kind         String  @default("single") @db.VarChar(16)
  Ordinal      Int     @default(0)
  BestOf       Int     @default(1) @db.TinyInt
  /// A final usually differs from the rest of its stage — BO1 groups, BO3
  /// playoffs, BO5 final — and a column is cheaper than a rule to remember.
  FinalBestOf  Int?    @db.TinyInt
  Config       String? @db.Text
  State        String  @default("pending") @db.VarChar(16)

  Tournament Tournament        @relation(fields: [TournamentId], references: [Id], onDelete: Cascade)
  Matches    TournamentMatch[]

  @@index([TournamentId, Ordinal])
  @@map("TournamentStages")
}

model TournamentTeam {
  Id             Int      @id @default(autoincrement())
  TournamentId   Int
  Name           String   @db.VarChar(64)
  Tag            String?  @db.VarChar(8)
  CaptainSteamId BigInt   @db.UnsignedBigInt
  Seed           Int?
  /// pending | accepted | withdrawn | disqualified
  Status         String   @default("pending") @db.VarChar(16)
  CreatedAt      DateTime @default(now()) @db.DateTime(6)
  /// The token in this team's player-invite link. Rotating it revokes a link
  /// that reached the wrong place, which is why it can be regenerated.
  InviteToken    String?  @unique(map: "UX_TournamentTeams_Invite") @db.VarChar(32)

  Tournament Tournament             @relation(fields: [TournamentId], references: [Id], onDelete: Cascade)
  Members    TournamentTeamMember[]

  @@unique([TournamentId, Name], map: "UX_TournamentTeams_Name")
  @@index([TournamentId])
  @@map("TournamentTeams")
}

model TournamentTeamMember {
  Id          Int       @id @default(autoincrement())
  TeamId      Int
  SteamId     BigInt    @db.UnsignedBigInt
  IsCaptain   Boolean   @default(false)
  /// invited | accepted | declined | removed
  Status      String    @default("invited") @db.VarChar(16)
  /// Roles are per side, because sides swap at halftime and a player carries one
  /// on each — a single column would mean somebody is a planter on CT.
  RoleT       String?   @db.VarChar(24)
  RoleCt      String?   @db.VarChar(24)
  /// What this player is called FOR THIS TOURNAMENT.
  ///
  /// Not an account rename. A Steam name changes on a whim and carries clan
  /// tags and jokes a bracket should not inherit; an organizer needs a stable
  /// name for the duration. Null falls back to the profile name.
  DisplayName String?   @db.VarChar(32)
  InvitedAt   DateTime  @default(now()) @db.DateTime(6)
  RespondedAt DateTime? @db.DateTime(6)

  Team TournamentTeam @relation(fields: [TeamId], references: [Id], onDelete: Cascade)

  @@unique([TeamId, SteamId], map: "UX_TournamentTeamMembers")
  @@index([SteamId])
  @@map("TournamentTeamMembers")
}

/// One match. NextMatchId and LoserNextMatchId are the bracket: a tree as
/// forward pointers rather than a second table, which is also what makes a
/// double-elimination loser's bracket nothing more than a second pointer.
model TournamentMatch {
  Id               Int       @id @default(autoincrement())
  TournamentId     Int
  StageId          Int
  /// The string handed to the plugin's css_t_go, and the join back from
  /// everything the game reports. The seam between the two halves of the system.
  MatchKey         String    @unique(map: "UX_TournamentMatches_Key") @db.VarChar(64)
  Round            Int       @default(1)
  Slot             Int       @default(0)
  BestOf           Int       @default(1) @db.TinyInt
  TeamAId          Int?
  TeamBId          Int?
  ScoreA           Int       @default(0)
  ScoreB           Int       @default(0)
  /// pending | veto | ready | live | finished | forfeit
  State            String    @default("pending") @db.VarChar(16)
  WinnerTeamId     Int?
  ServerId         Int?
  NextMatchId      Int?
  NextSlot         Int?      @db.TinyInt
  LoserNextMatchId Int?
  LoserNextSlot    Int?      @db.TinyInt
  ScheduledAt      DateTime? @db.DateTime(6)
  StartedAt        DateTime? @db.DateTime(6)
  EndedAt          DateTime? @db.DateTime(6)

  /// Ready-up per side. Columns rather than socket state, so a team that
  /// readied and then reconnected does not have to do it again.
  ReadyA           Boolean   @default(false)
  ReadyB           Boolean   @default(false)
  VetoStartedAt    DateTime? @db.DateTime(6)
  /// When the current veto turn runs out. Stored rather than computed so every
  /// viewer counts down to the same instant and a turn survives a reload.
  VetoDeadline     DateTime? @db.DateTime(6)

  Tournament  Tournament             @relation(fields: [TournamentId], references: [Id], onDelete: Cascade)
  Stage       TournamentStage        @relation(fields: [StageId], references: [Id], onDelete: Cascade)
  Maps        TournamentMatchMap[]
  Veto        TournamentVetoAction[]
  PlayerStats TournamentPlayerStat[]

  @@index([StageId, Round, Slot])
  @@index([TournamentId, State])
  @@map("TournamentMatches")
}

model TournamentMatchMap {
  Id                 Int     @id @default(autoincrement())
  MatchId            Int
  Ordinal            Int     @default(0)
  Map                String  @db.VarChar(64)
  PickedByTeamId     Int?
  SideChosenByTeamId Int?
  /// The side team A starts on, or null when a knife round decides it. That null
  /// is what the plugin reads to choose between css_t_side and css_t_knife.
  StartSideTeamA     String? @db.VarChar(2)
  IsDecider          Boolean @default(false)
  ScoreA             Int     @default(0)
  ScoreB             Int     @default(0)
  WinnerTeamId       Int?
  DemoFile           String? @db.VarChar(160)
  State              String  @default("pending") @db.VarChar(16)

  Match TournamentMatch @relation(fields: [MatchId], references: [Id], onDelete: Cascade)

  @@unique([MatchId, Ordinal], map: "UX_TournamentMatchMaps")
  @@index([MatchId])
  @@map("TournamentMatchMaps")
}

/// Who banned or picked what, in order. A veto is the part of a tournament that
/// gets argued about afterwards, and the site can only settle it if it remembers.
model TournamentVetoAction {
  Id      Int      @id @default(autoincrement())
  MatchId Int
  Ordinal Int
  TeamId  Int?
  /// ban | pick | side
  Kind    String   @db.VarChar(8)
  Map     String?  @db.VarChar(64)
  Side    String?  @db.VarChar(2)
  /// Whether a turn ran out and the system chose. An auto-pick that looks
  /// deliberate is a support conversation nobody can resolve.
  WasAuto Boolean  @default(false)
  ActedAt DateTime @default(now()) @db.DateTime(6)

  Match TournamentMatch @relation(fields: [MatchId], references: [Id], onDelete: Cascade)

  @@unique([MatchId, Ordinal], map: "UX_TournamentVetoActions")
  @@index([MatchId])
  @@map("TournamentVetoActions")
}

model TournamentMap {
  Id           Int    @id @default(autoincrement())
  TournamentId Int
  Map          String @db.VarChar(64)
  Ordinal      Int    @default(0)

  Tournament Tournament @relation(fields: [TournamentId], references: [Id], onDelete: Cascade)

  @@unique([TournamentId, Map], map: "UX_TournamentMaps")
  @@map("TournamentMaps")
}

model TournamentPlayerStat {
  Id            Int      @id @default(autoincrement())
  MatchId       Int
  MapId         Int?
  SteamId       BigInt   @db.UnsignedBigInt
  TeamId        Int?
  Kills         Int      @default(0)
  Deaths        Int      @default(0)
  Assists       Int      @default(0)
  Headshots     Int      @default(0)
  Damage        Int      @default(0)
  UtilityDamage Int      @default(0)
  EntryKills    Int      @default(0)
  EntryDeaths   Int      @default(0)
  Clutches      Int      @default(0)
  RoundsPlayed  Int      @default(0)
  KastRounds    Int      @default(0)
  Rating        Float    @default(0)
  UpdatedAt     DateTime @default(now()) @updatedAt @db.DateTime(6)

  /// Declared so a stat line can be filtered and grouped by its tournament —
  /// the profile and the tournament stats tab both ask that question. As
  /// elsewhere in this schema there is no database-level foreign key; the
  /// relation is what Prisma joins on.
  Match TournamentMatch @relation(fields: [MatchId], references: [Id], onDelete: Cascade)

  @@unique([MatchId, MapId, SteamId], map: "UX_TournamentPlayerStats")
  @@index([SteamId])
  @@map("TournamentPlayerStats")
}

/// The servers a tournament can run on — what replaces the single
/// RCON_HOST/PORT/PASSWORD triple read from the environment.
model GameServer {
  Id             Int      @id @default(autoincrement())
  Name           String   @db.VarChar(64)
  Host           String   @db.VarChar(128)
  Port           Int      @default(27015)
  RconPassword   String   @db.VarChar(128)
  ConnectAddress String?  @db.VarChar(160)
  GotvAddress    String?  @db.VarChar(160)
  /// idle | busy | offline | disabled
  Status         String   @default("idle") @db.VarChar(16)
  CurrentMatchId Int?
  IsTournament   Boolean  @default(true)
  UpdatedAt      DateTime @default(now()) @updatedAt @db.DateTime(6)

  @@index([Status])
  @@map("GameServers")
}

/// Casters allowed onto a tournament server. The roster is the allowlist for
/// players; without this, a free-camera server is one anybody can watch from
/// inside.
model TournamentSpectator {
  Id           Int      @id @default(autoincrement())
  TournamentId Int
  SteamId      BigInt   @db.UnsignedBigInt
  Name         String?  @db.VarChar(64)
  AddedAt      DateTime @default(now()) @db.DateTime(6)

  Tournament Tournament @relation(fields: [TournamentId], references: [Id], onDelete: Cascade)

  @@unique([TournamentId, SteamId], map: "UX_TournamentSpectators")
  @@map("TournamentSpectators")
}

/// A player asking for an admin, raised on the owner's page and in the desktop
/// app.
model TournamentAlert {
  Id        Int       @id @default(autoincrement())
  MatchKey  String    @db.VarChar(64)
  Map       String?   @db.VarChar(64)
  SteamId   BigInt    @db.UnsignedBigInt
  Name      String?   @db.VarChar(64)
  Team      String?   @db.VarChar(64)
  Score     String?   @db.VarChar(16)
  Reason    String?   @db.VarChar(240)
  CreatedAt DateTime  @default(now()) @db.DateTime(6)
  AckedAt   DateTime? @db.DateTime(6)
  AckedBy   BigInt?   @db.UnsignedBigInt

  @@index([AckedAt, CreatedAt])
  @@map("TournamentAlerts")
}
