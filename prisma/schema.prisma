generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Season {
  Id           Int       @id @default(autoincrement())
  Name         String
  StartedAtUtc DateTime  @db.DateTime(6)
  EndedAtUtc   DateTime? @db.DateTime(6)
  IsActive     Boolean

  @@map("Seasons")
}

model PlayerProfile {
  SteamId          BigInt   @id
  LastKnownName    String
  FirstSeenAtUtc   DateTime @db.DateTime(6)
  LastSeenAtUtc    DateTime @db.DateTime(6)
  TimeSpentSeconds Int      @default(0)
  accentColor      String?

  @@map("PlayerProfiles")
}

model PlayerSeasonStats {
  Id                   Int       @id @default(autoincrement())
  SeasonId             Int
  SteamId              BigInt
  Elo                  Int
  PeakElo              Int
  RankedRoundsPlayed   Int
  RankedRoundsWon      Int
  UnrankedRoundsPlayed Int
  LastRankedRoundAtUtc DateTime? @db.DateTime(6)
  UpdatedAtUtc         DateTime  @db.DateTime(6)
  IsCalibrating        Boolean   @default(true)

  @@unique([SeasonId, SteamId])
  @@map("PlayerSeasonStats")
}

model PlayerRoundRecord {
  Id                         BigInt   @id @default(autoincrement())
  RoundRecordId              BigInt
  SeasonId                   Int
  Map                        String
  PlayedAtUtc                DateTime @db.DateTime(6)
  IsRanked                   Boolean
  SteamId                    BigInt
  PlayerName                 String
  TeamNum                    Int
  WonRound                   Boolean
  Kills                      Int
  Headshots                  Int
  Assists                    Int
  FlashAssists               Int
  Damage                     Int
  UtilityDamage              Int
  EnemiesFlashed             Int
  EnemyBlindDuration         Float
  Died                       Boolean
  DiedAtSeconds              Float?
  WasTeamKilled              Boolean
  KilledTeammate             Boolean
  DiedEarly                  Boolean
  OpeningKill                Boolean
  OpeningDeath               Boolean
  TradeKills                 Int
  TradedDeath                Boolean
  Kast                       Boolean
  MultiKillCount             Int
  ClutchVersus               Int
  ClutchWon                  Boolean
  BombPlanted                Boolean
  BombDefused                Boolean
  WasAfk                     Boolean
  Rating                     Float
  EloDelta                   Int
  EloAfter                   Int
  /// A team kill after every enemy was dead or the bomb defused — scored the
  /// opposite way to one thrown while the round was live.
  KilledTeammateAfterDecided Boolean  @default(false)
  /// Itemised impact breakdown as JSON: what happened, what it was worth, and
  /// who else was involved. Written by the plugin alongside the rating.
  ImpactBreakdown            String?  @db.Text
  MapPerformancePoints       Float?   @db.Float
  ConsistencyMultiplier      Float?   @db.Float

  @@index([SteamId, PlayedAtUtc])
  @@index([SeasonId, SteamId])
  @@map("PlayerRoundRecords")
}

model RoundRecord {
  Id                   BigInt   @id @default(autoincrement())
  SeasonId             Int
  Map                  String
  PlayedAtUtc          DateTime @db.DateTime(6)
  RoundTypeOrdinal     Int      @default(-1)
  IsRanked             Boolean
  TPlayerCount         Int
  CtPlayerCount        Int
  WinnerTeamNum        Int
  BombSite             String?  @db.VarChar(8)
  BombPlanted          Boolean
  BombDefused          Boolean
  BombExploded         Boolean
  RoundDurationSeconds Float

  @@map("RoundRecords")
}

model GardenSchedulerState {
  Key          String   @id @db.VarChar(64)
  Value        String   @db.VarChar(64)
  UpdatedAtUtc DateTime @db.DateTime(6)

  @@map("GardenSchedulerState")
}

model PlayerConsistency {
  Id                  Int      @id @default(autoincrement())
  SeasonId            Int
  SteamId             BigInt
  LastScoredLocalDate String?  @db.VarChar(10)
  DailyScore          Float
  GlobalScore         Float
  CombinedScore       Float
  Multiplier          Float    @default(1)
  DailyRounds         Int
  GlobalRounds        Int
  LastBonusElo        Int
  UpdatedAtUtc        DateTime @db.DateTime(6)

  @@map("PlayerConsistency")
}

model CrTeamStats {
  Id            Int      @id @default(autoincrement())
  SeasonId      Int
  TeamKey       String
  PlayerNames   String   @db.VarChar(256)
  TeamSize      Int
  Elo           Int
  PeakElo       Int
  MatchesPlayed Int
  MatchesWon    Int
  MatchesDrawn  Int
  RoundsWon     Int
  RoundsLost    Int
  UpdatedAtUtc  DateTime @db.DateTime(6)

  @@unique([SeasonId, TeamKey])
  @@map("CrTeamStats")
}

model WebInventory {
  SteamId   BigInt   @id
  Data      String   @db.LongText
  UpdatedAt DateTime @updatedAt

  @@map("WebInventories")
}

model RetakesLobby {
  Id        String   @id @db.VarChar(64)
  LeaderId  BigInt?
  Mode      String   @default("2v2") @db.VarChar(16)
  CreatedAt DateTime @default(now())

  @@map("RetakesLobbies")
}

model GardenBan {
  SteamId      BigInt    @id
  Name         String
  Reason       String
  BannedBy     BigInt
  BannedAtUtc  DateTime
  ExpiresAtUtc DateTime?

  @@map("GardenBans")
}

model GardenNameOverride {
  SteamId BigInt @id @db.UnsignedBigInt
  Name    String

  @@map("GardenNameOverrides")
}

model GardenWebProfile {
  SteamId        BigInt    @id
  AvatarUrl      String?
  Bio            String?
  Country        String?
  UpdatedAt      DateTime  @updatedAt
  IsPro          Boolean   @default(false)
  ProSlug        String?   @unique
  PopConfig      String?   @db.VarChar(512)
  /// When this player last opened their notifications. Global events — CS2
  /// updates, new clips — are "unread" if they happened after this, which
  /// avoids writing a row per player per event.
  NotifSeenAtUtc DateTime? @db.DateTime(6)

  @@map("GardenWebProfiles")
}

model PlayerPassport {
  SteamId      BigInt   @id
  Username     String   @db.VarChar(64)
  Role         String   @db.VarChar(32)
  Age          Int
  Country      String   @db.VarChar(64)
  BackgroundId String   @db.VarChar(255)
  CreatedAt    DateTime @default(now()) @db.DateTime(6)
  UpdatedAt    DateTime @updatedAt @db.DateTime(6)

  @@map("PlayerPassports")
}

model GardenDiscordLink {
  SteamId       BigInt   @id
  DiscordId     String   @db.VarChar(32)
  DiscordName   String   @db.VarChar(64)
  DiscordAvatar String?  @db.VarChar(255)
  LinkedAtUtc   DateTime @default(now()) @db.DateTime(6)

  @@map("GardenDiscordLinks")
}

model GardenGoogleLink {
  SteamId      BigInt   @id
  GoogleId     String   @db.VarChar(128)
  GoogleEmail  String?  @db.VarChar(255)
  GoogleName   String   @db.VarChar(64)
  GoogleAvatar String?  @db.VarChar(255)
  LinkedAtUtc  DateTime @default(now()) @db.DateTime(6)

  @@map("GardenGoogleLinks")
}

model DuelRecord {
  Id             BigInt   @id @default(autoincrement())
  SeasonId       Int
  Map            String
  PlayedAtUtc    DateTime @db.DateTime(6)
  ArenaName      String
  WinnerSteamId  BigInt
  WinnerName     String
  LoserSteamId   BigInt
  LoserName      String
  IsChallenge    Boolean
  ChallengeScore String

  @@index([SeasonId])
  @@map("DuelRecords")
}

model GardenAdmin {
  SteamId    BigInt   @id @db.UnsignedBigInt
  Name       String
  Level      Int
  AddedBy    BigInt   @db.UnsignedBigInt
  AddedAtUtc DateTime @db.DateTime(6)

  @@map("GardenAdmins")
}

model GardenAdminLogEntry {
  Id            BigInt   @id @default(autoincrement())
  AtUtc         DateTime @db.DateTime(6)
  ActorSteamId  BigInt   @db.UnsignedBigInt
  ActorName     String
  Action        String
  TargetSteamId BigInt   @db.UnsignedBigInt
  TargetName    String
  Detail        String   @db.VarChar(256)

  @@map("GardenAdminLog")
}

model CrMatch {
  Id           BigInt    @id @default(autoincrement())
  SeasonId     Int
  Map          String
  StartedAtUtc DateTime  @db.DateTime(6)
  EndedAtUtc   DateTime? @db.DateTime(6)
  TeamAKey     String
  TeamBKey     String
  TeamAName    String    @db.VarChar(256)
  TeamBName    String    @db.VarChar(256)
  TeamSize     Int
  ScoreA       Int
  ScoreB       Int
  Result       String
  EloDeltaA    Int
  EloDeltaB    Int

  @@index([SeasonId])
  @@map("CrMatches")
}

model SharedLoadout {
  ShareKey     String   @id @db.VarChar(16)
  OwnerSteamId BigInt   @db.UnsignedBigInt
  OwnerName    String?
  Name         String
  Data         String   @db.LongText
  Featured     Boolean  @default(false)
  CreatedAt    DateTime @default(now()) @db.DateTime(6)

  @@index([Featured])
  @@map("SharedLoadouts")
}

model WebLiveMatch {
  ServerId     Int      @id
  Data         String   @db.LongText
  UpdatedAtUtc DateTime @db.DateTime(6)

  @@map("WebLiveMatches")
}

model GardenHeatmap {
  Id              BigInt   @id @default(autoincrement())
  VictimSteamId   BigInt
  AttackerSteamId BigInt
  MapName         String   @db.VarChar(128)
  VictimX         Float    @db.Float
  VictimY         Float    @db.Float
  VictimZ         Float    @db.Float
  AttackerX       Float    @db.Float
  AttackerY       Float    @db.Float
  AttackerZ       Float    @db.Float
  Weapon          String   @db.VarChar(64)
  IsHeadshot      Boolean
  IsRanked        Boolean
  Site            String?  @db.VarChar(16)
  CreatedAtUtc    DateTime @db.DateTime(6)

  @@index([MapName])
  @@index([VictimSteamId])
  @@index([AttackerSteamId])
  @@map("GardenHeatmaps")
}

model EFMigrationsHistory {
  MigrationId    String @id @db.VarChar(150)
  ProductVersion String @db.VarChar(32)

  @@map("__EFMigrationsHistory")
}

model UserSettings {
  UserId            BigInt @id
  WeaponPreferences String @db.Text

  @@map("UserSettings")
}

/// The half of a competitive retakes loadout the game does not read yet.
///
/// Weapons live in UserSettings above, because the allocator already reads that
/// every buy round and a second copy here would be a settings page that does
/// nothing. Role and utility preference have no in-game counterpart, so they
/// are website-owned: your team can read them, the server cannot act on them.
model GardenRetakeLoadout {
  SteamId      BigInt   @id @db.UnsignedBigInt
  /// One of lib/retakeLoadout ROLES, or "" for none chosen.
  RoleT        String   @default("") @db.VarChar(16)
  RoleCt       String   @default("") @db.VarChar(16)
  IsCaller     Boolean  @default(false)
  /// { pistol: [...], half: [...], full: [...] } — ordered, first choice first.
  UtilityPrefs String?  @db.Text
  Notes        String?  @db.VarChar(300)
  UpdatedAt    DateTime @default(now()) @updatedAt @db.DateTime(6)

  @@map("GardenRetakeLoadouts")
}

model WebFriendship {
  Id           Int      @id @default(autoincrement())
  RequesterId  BigInt   @db.UnsignedBigInt
  AddresseeId  BigInt   @db.UnsignedBigInt
  Status       String   @default("PENDING")
  CreatedAtUtc DateTime @default(now()) @db.DateTime(6)

  @@unique([RequesterId, AddresseeId])
  @@index([AddresseeId])
  @@map("WebFriendships")
}

model WebGameLobby {
  Id           String           @id @default(uuid())
  GameType     String
  HostSteamId  BigInt           @db.UnsignedBigInt
  Status       String           @default("WAITING")
  MaxPlayers   Int              @default(4)
  CreatedAtUtc DateTime         @default(now()) @db.DateTime(6)
  Players      WebLobbyPlayer[]

  @@map("WebGameLobbies")
}

model WebLobbyPlayer {
  Id          Int          @id @default(autoincrement())
  LobbyId     String
  SteamId     BigInt       @db.UnsignedBigInt
  JoinedAtUtc DateTime     @default(now()) @db.DateTime(6)
  Lobby       WebGameLobby @relation(fields: [LobbyId], references: [Id], onDelete: Cascade)

  @@unique([LobbyId, SteamId])
  @@map("WebLobbyPlayers")
}

model WebMessage {
  Id               Int      @id @default(autoincrement())
  SenderSteamId    BigInt   @db.UnsignedBigInt
  RecipientSteamId BigInt?  @db.UnsignedBigInt
  LobbyId          String?
  Content          String   @db.Text
  CreatedAtUtc     DateTime @default(now()) @db.DateTime(6)

  @@index([RecipientSteamId])
  @@index([LobbyId])
  @@map("WebMessages")
}

model WebNotification {
  Id           Int      @id @default(autoincrement())
  SteamId      BigInt   @db.UnsignedBigInt
  Type         String
  Content      String   @db.VarChar(256)
  IsRead       Boolean  @default(false)
  ActionUrl    String?  @db.VarChar(256)
  CreatedAtUtc DateTime @default(now()) @db.DateTime(6)

  @@index([SteamId])
  @@map("WebNotifications")
}

model NemesisRecord {
  KillerSteamId BigInt @db.UnsignedBigInt
  VictimSteamId BigInt @db.UnsignedBigInt
  Kills         Int

  @@id([KillerSteamId, VictimSteamId])
  @@map("NemesisRecords")
}

model PkmnTrainer {
  SteamId    BigInt         @id
  Money      Int            @default(0)
  CurrentMap String         @default("pallet_town")
  PosX       Int            @default(400)
  PosY       Int            @default(300)
  Facing     String         @default("down")
  Inventory  String         @db.LongText
  Badges     String         @db.LongText
  ApiTokens  PkmnApiToken[]
  Boxes      PkmnBox[]
  Party      PkmnMon[]      @relation("TrainerParty")

  @@map("PkmnTrainers")
}

model PkmnApiToken {
  Id            String      @id @default(cuid())
  SteamId       BigInt
  TokenHash     String      @unique
  DeviceName    String?
  CreatedAtUtc  DateTime    @default(now())
  LastUsedAtUtc DateTime    @default(now())
  ExpiresAtUtc  DateTime
  RevokedAtUtc  DateTime?
  Trainer       PkmnTrainer @relation(fields: [SteamId], references: [SteamId], onDelete: Cascade)

  @@index([SteamId])
  @@map("PkmnApiTokens")
}

model PkmnLinkCode {
  Code          String    @id
  PollToken     String    @unique
  DeviceName    String?
  SteamId       BigInt?
  CreatedAtUtc  DateTime  @default(now())
  ExpiresAtUtc  DateTime
  ConsumedAtUtc DateTime?

  @@map("PkmnLinkCodes")
}

model PkmnMon {
  Id       String      @id @default(cuid())
  OwnerId  BigInt
  Species  String
  Nickname String?
  Level    Int
  Exp      Int
  Hp       Int
  Status   String?
  Ability  String
  Nature   String
  Moves    String      @db.LongText
  Ivs      String      @db.LongText
  Evs      String      @db.LongText
  BoxId    String?
  Box      PkmnBox?    @relation(fields: [BoxId], references: [Id])
  Trainer  PkmnTrainer @relation("TrainerParty", fields: [OwnerId], references: [SteamId], onDelete: Cascade)

  @@index([BoxId], map: "PkmnMons_BoxId_fkey")
  @@index([OwnerId], map: "PkmnMons_OwnerId_fkey")
