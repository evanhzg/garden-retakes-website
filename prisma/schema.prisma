// Maps directly onto the tables created by GardenRankings (EF Core).
// Point DATABASE_URL at the same MySQL the plugin uses
// (DatabaseProvider = MySql in the plugin config).
//
// IMPORTANT: EF creates DateTime(6) and UnsignedBigInt columns.
// We must annotate them here so `prisma db push` doesn't try to cast them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ──────────────── EF-managed tables (plugin writes these) ────────────────

model Season {
  Id           Int       @id @default(autoincrement())
  Name         String
  StartedAtUtc DateTime  @db.DateTime(6)
  EndedAtUtc   DateTime? @db.DateTime(6)
  IsActive     Boolean

  @@map("Seasons")
}

model PlayerProfile {
  SteamId          BigInt   @id
  LastKnownName    String
  FirstSeenAtUtc   DateTime @db.DateTime(6)
  LastSeenAtUtc    DateTime @db.DateTime(6)
  TimeSpentSeconds Int      @default(0)
  accentColor      String?

  @@map("PlayerProfiles")
}

model PlayerSeasonStats {
  Id                   Int       @id @default(autoincrement())
  SeasonId             Int
  SteamId              BigInt
  Elo                  Int
  PeakElo              Int
  RankedRoundsPlayed   Int
  RankedRoundsWon      Int
  UnrankedRoundsPlayed Int
  LastRankedRoundAtUtc DateTime? @db.DateTime(6)
  UpdatedAtUtc         DateTime  @db.DateTime(6)
  IsCalibrating        Boolean   @default(true)

  @@unique([SeasonId, SteamId])
  @@map("PlayerSeasonStats")
}

model PlayerRoundRecord {
  Id                         BigInt   @id @default(autoincrement())
  RoundRecordId              BigInt
  SeasonId                   Int
  Map                        String
  PlayedAtUtc                DateTime @db.DateTime(6)
  IsRanked                   Boolean
  SteamId                    BigInt
  PlayerName                 String
  TeamNum                    Int
  WonRound                   Boolean
  Kills                      Int
  Headshots                  Int
  Assists                    Int
  FlashAssists               Int
  Damage                     Int
  UtilityDamage              Int
  EnemiesFlashed             Int
  EnemyBlindDuration         Float
  Died                       Boolean
  DiedAtSeconds              Float?
  WasTeamKilled              Boolean
  KilledTeammate             Boolean
  DiedEarly                  Boolean
  OpeningKill                Boolean
  OpeningDeath               Boolean
  TradeKills                 Int
  TradedDeath                Boolean
  Kast                       Boolean
  MultiKillCount             Int
  ClutchVersus               Int
  ClutchWon                  Boolean
  BombPlanted                Boolean
  BombDefused                Boolean
  WasAfk                     Boolean
  Rating                     Float
  EloDelta                   Int
  EloAfter                   Int
  /// A team kill after every enemy was dead or the bomb defused — scored the
  /// opposite way to one thrown while the round was live.
  KilledTeammateAfterDecided Boolean  @default(false)
  /// Itemised impact breakdown as JSON: what happened, what it was worth, and
  /// who else was involved. Written by the plugin alongside the rating.
  ImpactBreakdown            String?  @db.Text
  
  ConsistencyMultiplier      Float?   @db.Float
  MapPerformancePoints       Float?   @db.Float

  @@index([SteamId, PlayedAtUtc])
  @@index([SeasonId, SteamId])
  @@map("PlayerRoundRecords")
}

// EF-managed: one row per played round. Referenced by PlayerRoundRecord.
model RoundRecord {
  Id                   BigInt   @id @default(autoincrement())
  SeasonId             Int
  Map                  String
  PlayedAtUtc          DateTime @db.DateTime(6)
  RoundTypeOrdinal     Int      @default(-1)
  IsRanked             Boolean
  TPlayerCount         Int
  CtPlayerCount        Int
  WinnerTeamNum        Int
  BombSite             String?  @db.VarChar(8)
  BombPlanted          Boolean
  BombDefused          Boolean
  BombExploded         Boolean
  RoundDurationSeconds Float

  @@map("RoundRecords")
}

model CrTeamStats {
  Id            Int      @id @default(autoincrement())
  SeasonId      Int
  TeamKey       String
  PlayerNames   String   @db.VarChar(256)
  TeamSize      Int
  Elo           Int
  PeakElo       Int
  MatchesPlayed Int
  MatchesWon    Int
  MatchesDrawn  Int
  RoundsWon     Int
  RoundsLost    Int
  UpdatedAtUtc  DateTime @db.DateTime(6)

  @@unique([SeasonId, TeamKey])
  @@map("CrTeamStats")
}

// Website-owned: a player's saved inventory simulator loadouts (JSON blob),
// keyed by SteamID64. Served to the CS2 inventory-simulator plugin.
model WebInventory {
  SteamId   BigInt   @id
  Data      String   @db.LongText
  UpdatedAt DateTime @updatedAt

  @@map("WebInventories")
}

// Garden (W2): bans, display-name overrides, web profiles.
model GardenBan {
  SteamId      BigInt    @id
  Name         String
  Reason       String
  BannedBy     BigInt
  BannedAtUtc  DateTime
  ExpiresAtUtc DateTime?

  @@map("GardenBans")
}

model GardenNameOverride {
  SteamId BigInt @id @db.UnsignedBigInt
  Name    String

  @@map("GardenNameOverrides")
}

model GardenWebProfile {
  SteamId        BigInt    @id
  /// When this player last opened their notifications. Global events — CS2
  /// updates, new clips — are "unread" if they happened after this, which
  /// avoids writing a row per player per event.
  NotifSeenAtUtc DateTime? @db.DateTime(6)
  AvatarUrl      String?
  Bio            String?
  Country        String?
  IsPro          Boolean   @default(false)
  ProSlug        String?   @unique
  PopConfig      String?   @db.VarChar(512)
  UpdatedAt      DateTime  @updatedAt

  @@map("GardenWebProfiles")
}

// Discord account links (see lib/discord.ts + /api/auth/discord/*). Kept in its
// own table so the feature is inert — not fatal to other queries — until the
// table is created (sql/discord-link.sql).
model GardenDiscordLink {
  SteamId       BigInt   @id
  DiscordId     String   @db.VarChar(32)
  DiscordName   String   @db.VarChar(64)
  DiscordAvatar String?  @db.VarChar(255)
  LinkedAtUtc   DateTime @default(now()) @db.DateTime(6)

  @@map("GardenDiscordLinks")
}

model GardenGoogleLink {
  SteamId      BigInt   @id
  GoogleId     String   @db.VarChar(128)
  GoogleEmail  String?  @db.VarChar(255)
  GoogleName   String   @db.VarChar(64)
  GoogleAvatar String?  @db.VarChar(255)
  LinkedAtUtc  DateTime @default(now()) @db.DateTime(6)

  @@map("GardenGoogleLinks")
}

// Garden-retakes merged plugin (Duels mode): one row per completed 1v1.
model DuelRecord {
  Id             BigInt   @id @default(autoincrement())
  SeasonId       Int
  Map            String
  PlayedAtUtc    DateTime @db.DateTime(6)
  ArenaName      String
  WinnerSteamId  BigInt
  WinnerName     String
  LoserSteamId   BigInt
  LoserName      String
  IsChallenge    Boolean
  ChallengeScore String

  @@index([SeasonId])
  @@map("DuelRecords")
}

// Garden-retakes merged plugin (R3): admin storage + audit log.
model GardenAdmin {
  SteamId    BigInt   @id @db.UnsignedBigInt
  Name       String
  Level      Int
  AddedBy    BigInt   @db.UnsignedBigInt
  AddedAtUtc DateTime @db.DateTime(6)

  @@map("GardenAdmins")
}

model GardenAdminLogEntry {
  Id            BigInt   @id @default(autoincrement())
  AtUtc         DateTime @db.DateTime(6)
  ActorSteamId  BigInt   @db.UnsignedBigInt
  ActorName     String
  Action        String
  TargetSteamId BigInt   @db.UnsignedBigInt
  TargetName    String
  Detail        String   @db.VarChar(256)

  @@map("GardenAdminLog")
}

model CrMatch {
  Id           BigInt    @id @default(autoincrement())
  SeasonId     Int
  Map          String
  StartedAtUtc DateTime  @db.DateTime(6)
  EndedAtUtc   DateTime? @db.DateTime(6)
  TeamAKey     String
  TeamBKey     String
  TeamAName    String    @db.VarChar(256)
  TeamBName    String    @db.VarChar(256)
  TeamSize     Int
  ScoreA       Int
  ScoreB       Int
  Result       String
  EloDeltaA    Int
  EloDeltaB    Int

  @@index([SeasonId])
  @@map("CrMatches")
}

// Website-owned: a shareable snapshot of one loadout (self-contained: the
// loadout structure + the items it references). Borrowed via a short lowercase
// key on the website or in-game with /borrow <key>. Featured = curated presets.
model SharedLoadout {
  ShareKey     String   @id @db.VarChar(16)
  OwnerSteamId BigInt   @db.UnsignedBigInt
  OwnerName    String?
  Name         String
  Data         String   @db.LongText
  Featured     Boolean  @default(false)
  CreatedAt    DateTime @default(now()) @db.DateTime(6)

  @@index([Featured])
  @@map("SharedLoadouts")
}

model WebLiveMatch {
  ServerId     Int      @id
  Data         String   @db.LongText
  UpdatedAtUtc DateTime @db.DateTime(6)

  @@map("WebLiveMatches")
}

model GardenHeatmap {
  Id              BigInt   @id @default(autoincrement())
  VictimSteamId   BigInt
  AttackerSteamId BigInt
  MapName         String   @db.VarChar(128)
  VictimX         Float    @db.Float
  VictimY         Float    @db.Float
  VictimZ         Float    @db.Float
  AttackerX       Float    @db.Float
  AttackerY       Float    @db.Float
  AttackerZ       Float    @db.Float
  Weapon          String   @db.VarChar(64)
  IsHeadshot      Boolean
  IsRanked        Boolean
  Site            String?  @db.VarChar(16)
  CreatedAtUtc    DateTime @db.DateTime(6)

  @@index([MapName])
  @@index([VictimSteamId])
  @@index([AttackerSteamId])
  @@map("GardenHeatmaps")
}

// ──────────────── Legacy / EF-internal tables (preserve, don't drop) ────────────────

// EF Core migration history — must keep or EF can't track what it's applied.
model EFMigrationsHistory {
  MigrationId    String @id @db.VarChar(150)
  ProductVersion String @db.VarChar(32)

  @@map("__EFMigrationsHistory")
}

// Allocator plugin: weapon preferences per user (JSON blob in a text column).
model UserSettings {
  UserId            BigInt @id
  WeaponPreferences String @db.Text

  @@map("UserSettings")
}

/// The half of a competitive retakes loadout the game does not read yet.
///
/// Weapons live in UserSettings above, because the allocator already reads that
/// every buy round and a second copy here would be a settings page that does
/// nothing. Role and utility preference have no in-game counterpart, so they
/// are website-owned: your team can read them, the server cannot act on them.
model GardenRetakeLoadout {
  SteamId BigInt @id @db.UnsignedBigInt
  /// One of lib/retakeLoadout ROLES, or "" for none chosen.
  RoleT   String @default("") @db.VarChar(16)
  RoleCt  String @default("") @db.VarChar(16)
  /// { pistol: [...], half: [...], full: [...] } — ordered, first choice first.
  UtilityPrefs String? @db.Text
  Notes        String? @db.VarChar(300)
  UpdatedAt    DateTime @default(now()) @updatedAt @db.DateTime(6)

  @@map("GardenRetakeLoadouts")
}

// ---------------- Web Games / Social Features ----------------

model WebFriendship {
  Id           Int      @id @default(autoincrement())
  RequesterId  BigInt   @db.UnsignedBigInt
  AddresseeId  BigInt   @db.UnsignedBigInt
  Status       String   @default("PENDING") // PENDING, ACCEPTED, BLOCKED
  CreatedAtUtc DateTime @default(now()) @db.DateTime(6)

  @@unique([RequesterId, AddresseeId])
  @@index([AddresseeId])
  @@map("WebFriendships")
}

model WebGameLobby {
  Id           String   @id @default(uuid())
  GameType     String
  HostSteamId  BigInt   @db.UnsignedBigInt
  Status       String   @default("WAITING") // WAITING, PLAYING, FINISHED
  MaxPlayers   Int      @default(4)
  CreatedAtUtc DateTime @default(now()) @db.DateTime(6)

  Players WebLobbyPlayer[]

  @@map("WebGameLobbies")
}

model WebLobbyPlayer {
  Id          Int      @id @default(autoincrement())
  LobbyId     String
  SteamId     BigInt   @db.UnsignedBigInt
  JoinedAtUtc DateTime @default(now()) @db.DateTime(6)

  Lobby WebGameLobby @relation(fields: [LobbyId], references: [Id], onDelete: Cascade)

  @@unique([LobbyId, SteamId])
  @@map("WebLobbyPlayers")
}

model WebMessage {
  Id               Int      @id @default(autoincrement())
  SenderSteamId    BigInt   @db.UnsignedBigInt
  RecipientSteamId BigInt?  @db.UnsignedBigInt // null if lobby message
  LobbyId          String? // null if direct message
  Content          String   @db.Text
  CreatedAtUtc     DateTime @default(now()) @db.DateTime(6)

  @@index([RecipientSteamId])
  @@index([LobbyId])
  @@map("WebMessages")
}

model WebNotification {
  Id           Int      @id @default(autoincrement())
  SteamId      BigInt   @db.UnsignedBigInt
  Type         String // FRIEND_REQUEST, GAME_INVITE, SYSTEM
  Content      String   @db.VarChar(256)
  IsRead       Boolean  @default(false)
  ActionUrl    String?  @db.VarChar(256)
  CreatedAtUtc DateTime @default(now()) @db.DateTime(6)

  @@index([SteamId])
  @@map("WebNotifications")
}

model NemesisRecord {
  KillerSteamId BigInt @db.UnsignedBigInt
  VictimSteamId BigInt @db.UnsignedBigInt
  Kills         Int

  @@id([KillerSteamId, VictimSteamId])
  @@map("NemesisRecords")
}

// ---------------- Garden PKMN ----------------

model PkmnTrainer {
  SteamId    BigInt @id
  Money      Int    @default(0)
  CurrentMap String @default("pallet_town")
  PosX       Int    @default(400)
  PosY       Int    @default(300)
  Facing     String @default("down")
  Inventory  String @db.LongText // JSON
  Badges     String @db.LongText // JSON

  Party     PkmnMon[]      @relation("TrainerParty")
  Boxes     PkmnBox[]
  ApiTokens PkmnApiToken[]

  @@map("PkmnTrainers")
}

// Standalone game client (Unity) auth: one row per linked device/session, so
// a trainer can list ("signed in on N devices") and individually revoke
// access. The raw bearer token is never stored — only its SHA-256 hash.
model PkmnApiToken {
  Id            String    @id @default(cuid())
  SteamId       BigInt
  TokenHash     String    @unique
  DeviceName    String?
  CreatedAtUtc  DateTime  @default(now())
  LastUsedAtUtc DateTime  @default(now())
  ExpiresAtUtc  DateTime
  RevokedAtUtc  DateTime?

  Trainer PkmnTrainer @relation(fields: [SteamId], references: [SteamId], onDelete: Cascade)

  @@index([SteamId])
  @@map("PkmnApiTokens")
}

// Device-authorization pairing (RFC 8628-style, same shape Steam/consoles
// use): the game client requests a short human code, the player confirms
// it's them at pkmn.retakes.fr/link (already Steam-logged-in on the site),
// and the client polls until the code carries an issued bearer token.
model PkmnLinkCode {
  Code          String    @id
  PollToken     String    @unique
  DeviceName    String?
  SteamId       BigInt?
  CreatedAtUtc  DateTime  @default(now())
  ExpiresAtUtc  DateTime
  ConsumedAtUtc DateTime?

  @@map("PkmnLinkCodes")
}

model PkmnMon {
  Id       String  @id @default(cuid())
  OwnerId  BigInt
  Species  String
  Nickname String?
  Level    Int
  Exp      Int
  Hp       Int
  Status   String?

  Ability String
  Nature  String

  Moves String @db.LongText // JSON
  Ivs   String @db.LongText // JSON
  Evs   String @db.LongText // JSON

  Trainer PkmnTrainer @relation("TrainerParty", fields: [OwnerId], references: [SteamId], onDelete: Cascade)
  Box     PkmnBox?    @relation(fields: [BoxId], references: [Id], onDelete: SetNull)
  BoxId   String?

  @@map("PkmnMons")
}

model PkmnBox {
  Id      String @id @default(cuid())
  OwnerId BigInt
  Name    String @default("Box 1")

  Pokemon PkmnMon[]
  Trainer PkmnTrainer @relation(fields: [OwnerId], references: [SteamId], onDelete: Cascade)

  @@map("PkmnBoxes")
}

// ---------------- Web Games Stats ----------------

model WebGameMatch {
  Id          String   @id @default(uuid())
  GameId      String // e.g. "headshot", "ouno", "skribbl", "meme", "codenames"
  PlayedAtUtc DateTime @default(now()) @db.DateTime(6)
  Players     String   @db.LongText // JSON array of SteamIds
  WinnerId    BigInt?  @db.UnsignedBigInt
  Scores      String   @db.LongText // JSON mapping SteamId -> score
  DurationSec Int      @default(0)

  @@index([GameId])
  @@map("WebGameMatches")
}

model WebGameStats {
  SteamId       BigInt   @db.UnsignedBigInt
  GameId        String
  MatchesPlayed Int      @default(0)
  MatchesWon    Int      @default(0)
  TotalScore    Int      @default(0)
  Elo           Int      @default(1000)
  UpdatedAtUtc  DateTime @default(now()) @db.DateTime(6)

  @@id([SteamId, GameId])
  @@map("WebGameStats")
}

model SkinJob {
  id           Int      @id @default(autoincrement())
  workshop_url String   @db.VarChar(2048)
  image_url    String   @db.VarChar(2048)
  status       String   @default("pending") @db.VarChar(50)
  created_at   DateTime @default(now()) @db.DateTime(0)
  updated_at   DateTime @default(now()) @db.DateTime(0)

  @@map("skin_jobs")
}

// ── Feed ────────────────────────────────────────────────────────────────
// Clips and their reactions. New tables only — nothing here touches the
// tables the game plugin owns, so adding them cannot affect the server.

model FeedClip {
  Id          Int      @id @default(autoincrement())
  SteamId     BigInt   @db.UnsignedBigInt
  /// Hidden from the feed until its owner names it. A clip cut from a /clip
  /// mark arrives with a machine-written title nobody chose, so it waits.
  Unlisted    Boolean  @default(false)
  /// Which play session it came from, for per-session compilations.
  SessionId   String?  @db.VarChar(64)
  /// Comma-separated ids from the fixed tag list in lib/feedShared.
  Tags        String   @default("") @db.VarChar(200)
  Title       String   @db.VarChar(140)
  Description String?  @db.VarChar(500)
  /// "upload" (a file in data/clips) or "youtube" (a video id).
  Kind        String   @db.VarChar(16)
  /// Stored filename for an upload, or the YouTube video id.
  Source      String   @db.VarChar(255)
  /// Poster frame for uploads; YouTube serves its own.
  Thumb       String?  @db.VarChar(255)
  Bytes       Int?
  /// Seconds, when known (the highlight pipeline reports it).
  DurationSec Int?
  /// JSON array of {name,height,url} for R2-hosted clips, newest quality first.
  Variants    String?  @db.Text
  /// Stable id from the highlight pipeline, so a re-publish updates in place.
  ExternalId  String?  @unique @db.VarChar(190)
  /// In-game name from the demo, for players who have no profile on the site.
  /// Shown instead of a bare SteamID64, but never linked.
  PlayerName  String?  @db.VarChar(64)
  CreatedAt   DateTime @default(now()) @db.DateTime(6)

  Likes    FeedClipLike[]
  Comments FeedClipComment[]

  @@index([SteamId])
  @@index([CreatedAt])
  @@map("FeedClips")
}

model FeedClipLike {
  ClipId  Int
  SteamId BigInt   @db.UnsignedBigInt
  AtUtc   DateTime @default(now()) @db.DateTime(6)

  Clip FeedClip @relation(fields: [ClipId], references: [Id], onDelete: Cascade)

  @@id([ClipId, SteamId])
  @@map("FeedClipLikes")
}

model FeedClipComment {
  Id      Int      @id @default(autoincrement())
  ClipId  Int
  SteamId BigInt   @db.UnsignedBigInt
  Body    String   @db.VarChar(500)
  AtUtc   DateTime @default(now()) @db.DateTime(6)

  Clip FeedClip @relation(fields: [ClipId], references: [Id], onDelete: Cascade)

  @@index([ClipId])
  @@map("FeedClipComments")
}

/// A demo a player uploaded for the highlight pipeline to cut.
///
/// The file itself lives in R2, not here — Vercel caps a request body at
/// 4.5 MB and a demo is 100-300 MB, so the browser PUTs straight to the bucket
/// with a presigned URL. The row tracks what was asked for and how far it got,
/// and the object is deleted once clips exist so demos do not accumulate.
model FeedDemo {
  Id           Int       @id @default(autoincrement())
  SteamId      BigInt    @db.UnsignedBigInt
  FileName     String    @db.VarChar(255)
  /// Object key in the bucket; null once the demo has been wiped.
  ObjectKey    String?   @db.VarChar(320)
  Bytes        BigInt?   @db.UnsignedBigInt
  /// Comma-separated round numbers to cut, or null for every highlight found.
  Rounds       String?   @db.VarChar(120)
  /// Whose plays to cut. Defaults to the uploader.
  FocusSteamId BigInt?   @db.UnsignedBigInt
  /// uploading -> pending -> processing -> done | failed
  Status       String    @default("uploading") @db.VarChar(16)
  Note         String?   @db.VarChar(500)
  ClipCount    Int       @default(0)
  CreatedAt    DateTime  @default(now()) @db.DateTime(6)
  ProcessedAt  DateTime? @db.DateTime(6)

  @@index([SteamId])
  @@index([Status])
  @@map("FeedDemos")
}

/// A saved grenade lineup, shared between the game server and the utility page.
///
/// The plugin writes these when someone records a lineup in practice mode, and
/// the website reads them — the same route the heatmaps already take, rather
/// than shipping JSON files off the game server over FTP.
model GardenNade {
  Id      Int    @id @default(autoincrement())
  Map     String @db.VarChar(64)
  Name    String @db.VarChar(120)
  /// Callout the throw is *from*, so several Long lineups stay distinguishable.
  Area    String @default("") @db.VarChar(64)
  /// smoke | flash | molotov | he | decoy
  Utility String @default("smoke") @db.VarChar(16)
  /// default | execute | retake | postplant | trick
  Purpose String @default("default") @db.VarChar(16)
  /// T | CT | "" when it works for either side.
  Team    String @default("") @db.VarChar(2)

  /// standing | jump | step-jump | run | crouch
  ThrowType String @default("standing") @db.VarChar(16)
  /// left | right | both — left is a normal throw, right is the short lob.
  ClickType String @default("left") @db.VarChar(8)

  /// Where you stand, and where you look.
  StandX Float
  StandY Float
  StandZ Float
  Pitch  Float
  Yaw    Float

  /// Where it lands. Null when the lineup was recorded without one.
  LandX Float?
  LandY Float?
  LandZ Float?

  Notes   String? @db.VarChar(500)
  /// Filled in later by the clip pipeline.
  ClipUrl String? @db.VarChar(500)
  Thumb   String? @db.VarChar(500)

  /// The three stills every lineup site publishes, captured in game by
  /// tools/lineup-capture. Coordinates say where to stand; only a picture says
  /// what to look at, which is the part people actually copy.
  ///
  /// ShotStand — where you stand, wide enough to recognise the spot.
  /// ShotAim   — first person, crosshair on the aim point.
  /// ShotResult— where the grenade ended up.
  ShotStand  String? @db.VarChar(500)
  ShotAim    String? @db.VarChar(500)
  ShotResult String? @db.VarChar(500)

  /// False when the stand position does not sit on playable geometry — imported
  /// lineups are checked against the radar, recorded ones are true by definition.
  Verified Boolean @default(true)
  /// ingame | import
  Source   String  @default("ingame") @db.VarChar(16)

  AddedBySteamId BigInt?  @db.UnsignedBigInt
  CreatedAt      DateTime @default(now()) @db.DateTime(6)

  @@index([Map])
  @@index([Map, Area])
  @@map("GardenNades")
}

/// A `/clip` mark from the game server, waiting for the pipeline to cut it.
///
/// The server knows *when* something happened but cannot make a video — a demo
/// holds no pictures. So it records the mark, and the local pipeline turns it
/// into a clip later.
model GardenClipRequest {
  Id          Int     @id @default(autoincrement())
  SteamId     BigInt  @db.UnsignedBigInt
  PlayerName  String  @default("") @db.VarChar(64)
  Map         String  @db.VarChar(64)
  /// GOTV demo name without extension, as the server recorded it.
  DemoFile    String  @db.VarChar(160)
  /// One per map load — what groups a night's clips together.
  SessionId   String  @db.VarChar(64)
  /// Server tick when /clip was typed; the clip ends here.
  Tick        Int
  /// How far back from Tick to start.
  DurationSec Int     @default(15)
  /// pending -> processing -> done | failed
  Status      String  @default("pending") @db.VarChar(16)
  Note        String? @db.VarChar(500)
  /// The published clip, once there is one.
  ClipId      Int?

  CreatedAt   DateTime  @default(now()) @db.DateTime(6)
  ProcessedAt DateTime? @db.DateTime(6)

  @@index([Status])
  @@index([SessionId])
  @@index([SteamId])
  @@map("GardenClipRequests")
}

/// A user's suggestion to fix a lineup's setpos or details.
model GardenCaptureSuggestion {
  Id              Int      @id @default(autoincrement())
  LineupId        Int
  SuggestedSetpos String?  @db.VarChar(500)
  Notes           String?  @db.VarChar(500)
  Status          String   @default("pending") @db.VarChar(16) // pending, approved, rejected
  SubmittedBy     BigInt   @db.UnsignedBigInt
  CreatedAt       DateTime @default(now()) @db.DateTime(6)

  @@index([Status])
  @@map("GardenCaptureSuggestions")
}

/// A link on someone's profile, and whether anyone else may see it.
///
/// Steam, Discord and FACEIT are already known from elsewhere — this stores
/// their *visibility* alongside the handles people type in themselves, so one
/// row type covers "show my FACEIT" and "here is my YouTube" rather than the
/// page having two unrelated notions of a connection.
model GardenProfileLink {
  SteamId  BigInt
  /// steam | discord | faceit | x | youtube | instagram
  Provider String  @db.VarChar(16)
  /// Handle or full URL as typed; empty for providers we already know.
  Handle   String  @default("") @db.VarChar(160)
  /// Off by default: a link nobody chose to publish stays private.
  Public   Boolean @default(false)

  UpdatedAt DateTime @updatedAt @db.DateTime(6)

  @@id([SteamId, Provider])
  @@map("GardenProfileLinks")
}

/// A medal that can be held. Definitions, not awards.
model GardenMedal {
  Id          Int    @id @default(autoincrement())
  Slug        String @unique @db.VarChar(48)
  Name        String @db.VarChar(64)
  Description String @db.VarChar(240)
  /// Emoji, so a medal needs no asset pipeline to exist.
  Icon        String @default("🏅") @db.VarChar(8)
  Colour      String @default("#e8b53a") @db.VarChar(9)
  /// season (placement) | vote (community) | special (given by hand)
  Kind        String @default("vote") @db.VarChar(16)
  /// Order in the case, low first.
  Sort        Int    @default(100)

  CreatedAt DateTime @default(now()) @db.DateTime(6)

  @@map("GardenMedals")
}

/// Somebody holding a medal, for a season.
model GardenPlayerMedal {
  Id        Int      @id @default(autoincrement())
  SteamId   BigInt   @db.UnsignedBigInt
  MedalSlug String   @db.VarChar(48)
  SeasonId  Int
  /// Free text — "1st, 412 votes", "Season 1".
  Note      String?  @db.VarChar(120)
  AwardedAt DateTime @default(now()) @db.DateTime(6)

  /// One of each medal per player per season.
  @@unique([SteamId, MedalSlug, SeasonId])
  @@index([SteamId])
  @@map("GardenPlayerMedals")
}

/// A community vote. One per season end, open for a fixed window.
model GardenVotePoll {
  Id         Int      @id @default(autoincrement())
  SeasonId   Int
  OpensAt    DateTime @db.DateTime(6)
  ClosesAt   DateTime @db.DateTime(6)
  /// Snapshot of who was eligible when it opened, so the ballot cannot change
  /// under voters if the ladder moves.
  Candidates String   @db.Text
  CreatedAt  DateTime @default(now()) @db.DateTime(6)

  @@index([SeasonId])
  @@map("GardenVotePolls")
}

/// One question on the ballot.
model GardenVoteCategory {
  Id          Int    @id @default(autoincrement())
  PollId      Int
  Slug        String @db.VarChar(48)
  Name        String @db.VarChar(64)
  Description String @db.VarChar(240)
  /// The medal the winner receives.
  MedalSlug   String @db.VarChar(48)
  Sort        Int    @default(100)

  @@unique([PollId, Slug])
  @@map("GardenVoteCategories")
}

/// A ballot line.
///
/// The unique key is what makes "one vote per person per category" true rather
/// than merely intended — the UI could be bypassed, the database cannot.
model GardenVote {
  Id            Int      @id @default(autoincrement())
  CategoryId    Int
  VoterSteamId  BigInt   @db.UnsignedBigInt
  TargetSteamId BigInt   @db.UnsignedBigInt
  CreatedAt     DateTime @default(now()) @db.DateTime(6)
  UpdatedAt     DateTime @updatedAt @db.DateTime(6)

  @@unique([CategoryId, VoterSteamId])
  @@index([CategoryId])
  @@map("GardenVotes")
}

/// A like on a comment.
model FeedClipCommentLike {
  Id        Int      @id @default(autoincrement())
  CommentId Int
  SteamId   BigInt   @db.UnsignedBigInt
  CreatedAt DateTime @default(now()) @db.DateTime(6)

  @@unique([CommentId, SteamId])
  @@index([CommentId])
  @@map("FeedClipCommentLikes")
}
